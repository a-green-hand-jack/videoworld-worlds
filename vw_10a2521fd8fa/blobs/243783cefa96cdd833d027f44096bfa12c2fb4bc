[
[
"L01",
"NARRATOR",
"Bitter cold, almost dark: the last evening of the year."
],
[
"L02",
"NARRATOR",
"A poor girl shuffled along in her mother's big slippers."
],
[
"L03",
"NARRATOR",
"Carriages raced by; she lost them, and went on barefoot."
],
[
"L04",
"GIRL",
"Matches… who will buy my matches?"
],
[
"L05",
"NARRATOR",
"No one had bought a single match."
],
[
"L06",
"NARRATOR",
"Candles gleamed in the windows; it smelled of roast goose."
],
[
"L07",
"NARRATOR",
"She huddled in a corner, afraid to go home to her father."
],
[
"L08",
"NARRATOR",
"Her hands were numb. If she dared strike just one…"
],
[
"L09",
"NARRATOR",
"How it blazed! A warm iron stove seemed to stand before her."
],
[
"L10",
"NARRATOR",
"Then it went out."
],
[
"L11",
"NARRATOR",
"A second: the wall became a veil, and inside, a roast goose steamed."
],
[
"L12",
"NARRATOR",
"It hopped down and waddled toward her — then darkness."
],
[
"L13",
"NARRATOR",
"A third: she sat beneath a Christmas tree ablaze with candles."
],
[
"L14",
"NARRATOR",
"Out it went. The lights rose and became stars. One fell."
],
[
"L15",
"GIRL",
"Someone is dying."
],
[
"L16",
"NARRATOR",
"Her grandmother, the only one who had loved her, had said: a falling star is a soul going to God."
],
[
"L17",
"NARRATOR",
"A fourth — and there stood Grandmother, shining and kind."
],
[
"L18",
"GIRL",
"Grandmother! Take me with you!"
],
[
"L19",
"NARRATOR",
"She struck the whole bundle, to keep her near."
],
[
"L20",
"NARRATOR",
"Grandmother took her in her arms, and they flew up, where there is no cold, no hunger, no fear."
],
[
"L21",
"NARRATOR",
"At dawn she sat there still, rosy-cheeked and smiling — frozen to death."
],
[
"L22",
"PASSERBY",
"She wanted to warm herself."
],
[
"L23",
"NARRATOR",
"No one knew the beautiful things she had seen, or the joy she had gone to."
]
]