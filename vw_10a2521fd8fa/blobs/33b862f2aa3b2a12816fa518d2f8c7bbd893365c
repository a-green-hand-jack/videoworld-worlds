#!/usr/bin/env python3
"""judder.py file [start end] : motion-energy series d[i] = mean |frame[i+1]-frame[i]| (luma, 320x180); ripple = std of the
residual after a 12-frame running mean, over the mean of d (a steady move gives ~0, a 4th/5th-frame cadence gives >0.05);
held = frames with d < 10% of the median; jump = frames with d > 3x the running mean. (dp's own stand-in for qc's judder.py, which dp cannot read.)"""
import sys, subprocess, numpy as np
f = sys.argv[1]
cmd = ["ffmpeg", "-loglevel", "error"] + (["-ss", sys.argv[2], "-to", sys.argv[3]] if len(sys.argv) > 3 else []) + ["-i", f, "-vf", "scale=320:180,format=gray", "-f", "rawvideo", "-"]
a = np.frombuffer(subprocess.check_output(cmd), np.uint8).reshape(-1, 180, 320).astype(float)
d = np.abs(np.diff(a, axis=0)).mean((1, 2)); k = 12
tr = np.convolve(d, np.ones(k)/k, "same")
rip = np.std((d - tr)[k:-k]) / max(d.mean(), 1e-6)
held = int((d < 0.1 * np.median(d)).sum()); jump = int((d[k:-k] > 3 * tr[k:-k]).sum())
print(f"{f}: frames {len(a)} mean d {d.mean():.3f} ripple {rip:.3f} held {held} jump {jump}")
