   "id": "s16",
   "dur": 8.4167,
   "tc": "01:35–01:42",
   "lines": "20",
   "src": null,
   "bg": "0x1b2240",
   "slate": "Wide, rising  [white-gold over STREET below]\n\nThe grandmother lifts the girl in her arms; both fly upward in light\nand joy, high above the snowy rooftops into a glowing sky."
  },
