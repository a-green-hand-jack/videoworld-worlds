#!/usr/bin/env python3
"""gen.py OUT.png "prompt" [ref1.png ref2.png ...]  -- image-generation via the world's proxy"""
import sys, os, json, base64, subprocess, urllib.request
out, prompt, refs = sys.argv[1], sys.argv[2], sys.argv[3:]
url = subprocess.check_output(["ht-resource","url","image-generation"]).decode().strip()
model = os.environ.get("MODEL","gemini-3-pro-image")
parts=[{"text":prompt}]
for r in refs:
    mt = "image/jpeg" if r.lower().endswith(("jpg","jpeg")) else "image/png"
    parts.append({"inlineData":{"mimeType":mt,"data":base64.b64encode(open(r,"rb").read()).decode()}})
body=json.dumps({"contents":[{"parts":parts}],"generationConfig":{"responseModalities":["IMAGE"],"imageConfig":{"aspectRatio":os.environ.get("AR","16:9")}}}).encode()
req=urllib.request.Request(f"{url}/v1beta/models/{model}:generateContent",body,{"Content-Type":"application/json","x-goog-api-key":os.environ["HT_RESOURCE_TOKEN"]})
d=json.load(urllib.request.urlopen(req,timeout=300))
for p in d["candidates"][0]["content"]["parts"]:
    if "inlineData" in p:
        open(out,"wb").write(base64.b64decode(p["inlineData"]["data"])); print("ok",out); break
else:
    print("no image",json.dumps(d)[:500]); sys.exit(1)
