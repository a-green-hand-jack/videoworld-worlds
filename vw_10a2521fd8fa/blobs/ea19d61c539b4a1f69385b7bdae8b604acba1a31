#!/usr/bin/env python3
"""cut-v6a EDL: cut-v5d's timeline, shots, mix (mix-cut-v5c) and subtitle timing, rendered with the conform's
sub-pixel push-ins (no whole-pixel judder on the stills) and two subtitle cues re-wrapped. Run from this directory."""
import json
e = json.load(open("../cut-v5d/edl.json"))
