#!/usr/bin/env python3
"""Speed of a slow move over a frame gap (default 6) to beat the noise of single-frame phase correlation.
usage: gapspeed.py film.mp4 START END [GAP] -> per-frame M(t, t+GAP)/GAP and its spread (judder.py's pair())."""
import sys, subprocess, numpy as np
sys.argv_save = sys.argv; sys.argv = [sys.argv[0]]
src = open(__file__.replace('gapspeed.py', 'judder.py')).read().split('def main')[0]
exec(src)
film, t0, t1 = sys_args = sys.argv_save[1], float(sys.argv_save[2]), float(sys.argv_save[3])
gap = int(sys.argv_save[4]) if len(sys.argv_save) > 4 else 6
p = subprocess.Popen(['ffmpeg', '-v', 'error', '-ss', str(t0), '-t', str(t1 - t0), '-i', film, '-vf', 'format=gray', '-vsync', '0', '-f', 'rawvideo', '-'], stdout=subprocess.PIPE)
fr = []
while True:
    b = p.stdout.read(W * H)
    if len(b) < W * H: break
    fr.append(np.frombuffer(b, np.uint8).reshape(H, W)[:ROWS].astype(np.float32))
v = np.array([pair(fr[i], fr[i + gap])[3] / gap for i in range(len(fr) - gap)])
v = v[3:-3]
print(f'{sys.argv_save[2]}-{sys.argv_save[3]} gap {gap}: mean {v.mean():.3f} px/f, sd {v.std():.3f}, sd/mean {v.std()/v.mean():.3f}, min/max {v.min():.3f}/{v.max():.3f}')
print(' '.join(f'{x:.2f}' for x in v[::3]))
