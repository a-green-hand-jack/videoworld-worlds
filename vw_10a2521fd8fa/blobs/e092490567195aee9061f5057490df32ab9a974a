#!/usr/bin/env python3
"""wan.py submit ID  |  wan.py collect  : Wan 2.7 image-to-video via video-generation-wan.
Shots are defined in WAN below (first frame, optional last frame, seconds, prompt). Task ids kept in tools/wan_tasks.json."""
import sys, os, json, base64, subprocess, urllib.request
sys.path.insert(0, os.path.dirname(__file__))
STYLE = "soft gouache and watercolour storybook illustration, painterly with visible paper grain, not photoreal, no text or lettering"
