def b64(n):
    return "data:image/png;base64," + base64.b64encode(open(f"keyframes/{n}.png", "rb").read()).decode()
base = subprocess.check_output(["ht-resource", "url", "video-generation-wan"]).decode().strip()
H = {"Authorization": "Bearer " + os.environ["HT_RESOURCE_TOKEN"], "Content-Type": "application/json"}
TASKS = "tools/wan_tasks.json"
def load(): return json.load(open(TASKS)) if os.path.exists(TASKS) else {}
def call(path, body=None, extra={}):
    req = urllib.request.Request(base + path, json.dumps(body).encode() if body else None, {**H, **extra})
    try: return json.load(urllib.request.urlopen(req, timeout=120))
    except urllib.error.HTTPError as e: return {"http": e.code, "body": e.read()[:400].decode()}
if sys.argv[1] == "submit":
    for sid in sys.argv[2:]:
        first, last, dur, mot, *xneg = WAN[sid]
        prompt = f"{mot} Style: {STYLE}. No cuts."
        media = [{"type": "first_frame", "url": b64(first)}] + ([{"type": "last_frame", "url": b64(last)}] if last else [])
        r = call("/api/v1/services/aigc/video-generation/video-synthesis",
                 {"model": "wan2.7-i2v", "input": {"prompt": prompt, "negative_prompt": NEG + (", " + xneg[0] if xneg else ""), "media": media},
                  "parameters": {"resolution": os.environ.get("WANRES","720P"), "duration": dur}}, {"X-DashScope-Async": "enable"})
        print(sid, json.dumps(r)[:300])
        t = r.get("output", {}).get("task_id")
        if t:
            T = load(); T.setdefault(sid, []).append({"task": t, "prompt": prompt, "first": first, "last": last, "dur": dur, "done": False}); json.dump(T, open(TASKS, "w"), indent=1)
else:
    T = load()
    for sid, L in T.items():
        for i, e in enumerate(L):
            if e["done"]: continue
            r = call("/api/v1/tasks/" + e["task"]); o = r.get("output", {}); st = o.get("task_status")
            print(sid, i, st, o.get("code", ""), o.get("message", ""), flush=True)
            if st == "SUCCEEDED":
                out = f"shots/{sid}_wan{i+1}.mp4"; raw = f"/hutian/work/{sid}_wan{i+1}_raw.mp4"
                subprocess.check_call(["curl", "-fsSL", "-o", raw, o["video_url"]])
                subprocess.check_call(["ffmpeg", "-y", "-loglevel", "error", "-i", raw, "-vf", "tmix=frames=5:weights=1 2 3 2 1,framerate=fps=24,scale=1280:720:flags=lanczos", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "15", "-an", out])
                e["done"] = True; e["file"] = out
            elif st == "FAILED": e["done"] = True; e["failed"] = o.get("message", "")
    json.dump(T, open(TASKS, "w"), indent=1)
