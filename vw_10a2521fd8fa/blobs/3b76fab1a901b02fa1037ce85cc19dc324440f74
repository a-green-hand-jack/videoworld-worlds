#!/usr/bin/env python3
"""Snap each subtitle cue's start to the voice onset in the dialogue stem (the first 10 ms window
above -34 dBFS after >=0.2 s below it) when one lies within 0.6 s, and report the offsets.
usage: snap_srt.py IN.srt DIALOGUE.wav OUT.srt"""
import re, sys, textwrap
import numpy as np, soundfile as sf
sys.path.insert(0, __import__("os").path.dirname(__file__))
from fix_srt import parse, tc  # noqa: E402

cues = parse(sys.argv[1])
x, sr = sf.read(sys.argv[2]); x = np.abs(x).max(1) if x.ndim > 1 else np.abs(x)
w = sr // 100; n = len(x) // w; on = x[: n * w].reshape(n, w).max(1) > 0.02
onsets = [k / 100 for k in range(20, n) if on[k] and not on[k - 20:k].any()]
worst = 0.0
for i, c in enumerate(cues):
    near = [o for o in onsets if abs(o - c[0]) <= 0.6]
    if near:
        o = min(near, key=lambda o: abs(o - c[0]))
        print(f"cue {i+1:2d} {c[0]:7.3f} onset {o - c[0]:+.2f}  {' '.join(c[2])[:40]}")
        c[0] = o
        if i and cues[i - 1][1] > o - 0.04:
            cues[i - 1][1] = o - 0.04
    else:
        print(f"cue {i+1:2d} {c[0]:7.3f} no onset within 0.6 s  {' '.join(c[2])[:40]}")
def wrap(lines, limit=42):
    """Rebalance a cue whose lines exceed `limit` characters into two balanced lines."""
    if max(map(len, lines)) <= limit:
        return lines
    w = " ".join(lines).split(); best = None
    for k in range(1, len(w)):
        a, b = " ".join(w[:k]), " ".join(w[k:])
        if len(a) <= limit and len(b) <= limit and (best is None or abs(len(a) - len(b)) < best[0]):
            best = (abs(len(a) - len(b)), a, b)
    print("rewrapped:", best[1], "/", best[2])
    return [best[1], best[2]]

# split a two-sentence cue at the pause between its sentences (>= 0.25 s below threshold), so each sentence
# is on screen only while it is spoken
quiet = ~on
out = []
for c in cues:
    text = " ".join(c[2]); m = list(re.finditer(r"[.!?…]\s+", text))
    gaps = []
    a, b = int(c[0] * 100), int(c[1] * 100)
    k = a
    while k < b:
        if quiet[k]:
            j = k
            while j < b and quiet[j]: j += 1
            if j - k >= 25 and j < b - 30: gaps.append((k / 100, j / 100))
            k = j
        k += 1
    if m and gaps:
        cut = m[0].end(); g = gaps[0]
        print(f"split '{text[:cut].strip()}' / '{text[cut:].strip()}' at {g[0]:.2f}-{g[1]:.2f}")
        out.append([c[0], g[0] + 0.1, textwrap.wrap(text[:cut].strip(), 42)])
        out.append([g[1], c[1], textwrap.wrap(text[cut:].strip(), 42)])
    else:
        out.append(c)
cues = out
with open(sys.argv[3], "w", encoding="utf-8") as f:
    for i, c in enumerate(cues, 1):
        f.write(f"{i}\n{tc(c[0])} --> {tc(c[1])}\n" + "\n".join(wrap(c[2])) + "\n\n")
