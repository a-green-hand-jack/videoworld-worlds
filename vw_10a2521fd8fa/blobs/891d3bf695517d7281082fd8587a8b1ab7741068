#!/usr/bin/env python3
"""cad.py file : alt2 = mean |d[i]-d[i+1]| / mean d (alternation of big/small frame change), p12 = FFT peak near Nyquist/2 over the mean spectrum level"""
import sys, subprocess, numpy as np
for f in sys.argv[1:]:
    a = np.frombuffer(subprocess.check_output(["ffmpeg","-loglevel","error","-i",f,"-vf","scale=320:180,format=gray","-f","rawvideo","-"]), np.uint8).reshape(-1,180,320).astype(float)
    d = np.abs(np.diff(a, axis=0)).mean((1,2)); n = len(d)
    alt2 = np.abs(np.diff(d)).mean() / d.mean() / 2
    sp = np.abs(np.fft.rfft(d - d.mean())); fr = np.fft.rfftfreq(n, 1/24)
    print(f"{f}: frames {len(a)} alt2(norm) {alt2:.3f} held {(d<0.1*np.median(d)).sum()} top spectrum {[(round(fr[i],1), round(sp[i]/sp[1:].mean(),1)) for i in np.argsort(sp[1:])[-3:]+1]}")
