#!/usr/bin/env python3
"""Cadence of a take or a cut segment: mean abs luma difference of consecutive frames (320x180, top 140 rows, as in
the director's scan lock/round2/cadence-cut-v6b.txt), alt2 = median |d_even - d_odd| / (d_even + d_odd) over
neighbouring pairs (0 = even motion, 0.3+ = every other frame nearly static).
usage: cadence.py FILE [START DUR] ..."""
import subprocess, sys
import numpy as np

def diffs(path, ss=None, t=None):
    cmd = ["ffmpeg", "-v", "error"] + (["-ss", str(ss), "-t", str(t)] if ss is not None else []) + \
          ["-i", path, "-vf", "scale=320:180,format=gray", "-f", "rawvideo", "-"]
    a = np.frombuffer(subprocess.run(cmd, capture_output=True).stdout, np.uint8).reshape(-1, 180, 320)[:, :140].astype(float)
    return np.abs(np.diff(a, axis=0)).mean(axis=(1, 2))

def alt2(d):
    d = d[: len(d) // 2 * 2].reshape(-1, 2)
    return float(np.median(np.abs(d[:, 0] - d[:, 1]) / np.maximum(d.sum(1), 1e-6)))

if __name__ == "__main__":
    a = sys.argv[1:]
    d = diffs(a[0], *(a[1:3] if len(a) > 2 else []))
    print(f"{a[0]}: frames {len(d)+1}, mean {d.mean():.2f}, alt2 {alt2(d):.2f}")
