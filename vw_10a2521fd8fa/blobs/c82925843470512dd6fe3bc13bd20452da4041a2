#!/usr/bin/env python3
"""Render a seamless falling-snow layer (white flakes on black) for screen-blending over stills.
usage: make_snow.py OUT.mp4 [SECONDS=12] [SEED=7]"""
import subprocess, sys
import numpy as np

out = sys.argv[1]; T = float(sys.argv[2]) if len(sys.argv) > 2 else 12.0
rng = np.random.default_rng(int(sys.argv[3]) if len(sys.argv) > 3 else 7)
W, H, FPS = 1280, 720, 24; N = int(T * FPS)
layers = []  # (count, radius, speed px/s, alpha): far small slow flakes, near big fast ones
for cnt, r, v, a in ((260, 1.2, 40, 0.55), (140, 2.0, 70, 0.75), (45, 3.2, 110, 0.9)):
    layers.append((rng.uniform(0, W, cnt), rng.uniform(0, H, cnt), rng.uniform(0, 2 * np.pi, cnt), r, v, a))
yy, xx = np.mgrid[-5:6, -5:6]
p = subprocess.Popen(["ffmpeg", "-y", "-v", "error", "-f", "rawvideo", "-pix_fmt", "gray", "-s", f"{W}x{H}",
                      "-r", str(FPS), "-i", "-", "-c:v", "libx264", "-crf", "14", "-pix_fmt", "yuv420p", out],
                     stdin=subprocess.PIPE)
for f in range(N):
    t = f / FPS; img = np.zeros((H + 12, W + 12), np.float32)
    for x0, y0, ph, r, v, a in layers:
        # loop exactly every T seconds: vertical travel is a whole number of screen heights per loop
        vv = round(v * T / H) * H / T
        x = (x0 + 12 * np.sin(2 * np.pi * t / T * 2 + ph)) % W
        y = (y0 + vv * t) % H
        k = np.exp(-(xx ** 2 + yy ** 2) / (2 * r * r)) * a
        for xi, yi in zip(x.astype(int), y.astype(int)):
            img[yi:yi + 11, xi:xi + 11] = np.maximum(img[yi:yi + 11, xi:xi + 11], k)
    p.stdin.write((np.clip(img[6:H + 6, 6:W + 6], 0, 1) * 255).astype(np.uint8).tobytes())
p.stdin.close(); p.wait()
print("wrote", out)
