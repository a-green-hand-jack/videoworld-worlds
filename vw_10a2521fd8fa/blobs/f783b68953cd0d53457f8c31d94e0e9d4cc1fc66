#!/usr/bin/env python3
"""evenwan.py RAW.mp4 OUT.mp4 : for a Wan take whose motion arrives every other frame (near-duplicate frames between): keep the frames that
differ from their predecessor by more than the local median, lay them evenly in time, and motion-interpolate (minterpolate mci) to 24 fps."""
import sys, subprocess, numpy as np, os, tempfile
raw, out = sys.argv[1:3]
a = np.frombuffer(subprocess.check_output(["ffmpeg","-loglevel","error","-i",raw,"-vf","scale=320:180,format=gray","-f","rawvideo","-"]), np.uint8).reshape(-1,180,320).astype(float)
d = np.abs(np.diff(a, axis=0)).mean((1,2)); n = len(a)
keep = [0] + [j for j in range(1, n) if d[j-1] > np.median(d[max(0,j-5):j+4])]
T = n / 30.0; rate = len(keep) / T
print(f"kept {len(keep)}/{n} -> {rate:.1f} fps effective")
tmp = tempfile.mkdtemp(dir="/hutian/work")
sel = "+".join(f"eq(n\\,{j})" for j in keep)
subprocess.check_call(["ffmpeg","-y","-loglevel","error","-i",raw,"-vf",f"select='{sel}',setpts=N/({rate}*TB),minterpolate=fps=24:mi_mode=mci:mc_mode=aobmc:vsbmc=1","-an","-c:v","libx264","-crf","15","-pix_fmt","yuv420p",out])
