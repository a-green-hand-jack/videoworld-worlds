"""word timings inside each line wav (faster-whisper), saved to lines/words.json for subtitle cue splitting"""
import json
from faster_whisper import WhisperModel
m = WhisperModel("small.en", compute_type="int8")
out = {}
for i, sp, t in json.load(open("tools/lines.json")):
    s, _ = m.transcribe(f"lines/{i}.wav", word_timestamps=True)
    out[i] = [(w.word.strip(), round(w.start, 3), round(w.end, 3)) for x in s for w in x.words]
json.dump(out, open("lines/words.json", "w"))
print({k: len(v) for k, v in out.items()})
