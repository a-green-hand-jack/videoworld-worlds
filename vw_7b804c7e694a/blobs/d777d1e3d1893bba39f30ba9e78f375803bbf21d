 "srt": "scratch.srt",
 "out": "cut-v1.mp4",
 "lines": [
  {
   "line": "1",
   "shot": "1",
   "speaker": "NARRATOR",
   "start": 0.3,
   "end": 5.099,
   "dur": 4.799,
   "measured": true,
   "text": "Terribly cold it was, and almost dark — the last evening of the year."
  },
  {
   "line": "2",
   "shot": "2",
   "speaker": "NARRATOR",
   "start": 5.883,
   "end": 9.875,
   "dur": 3.992,
   "measured": true,
   "text": "A poor little girl shuffled along in her mother's big slippers."
  },
  {
   "line": "3",
   "shot": "3",
   "speaker": "NARRATOR",
   "start": 10.508,
   "end": 16.426,
   "dur": 5.918,
   "measured": true,
   "text": "Two carriages raced by — she lost them, a boy ran off with one, and now she was barefoot."
  },
  {
   "line": "4",
   "shot": "4",
   "speaker": "GIRL",
   "start": 17.008,
   "end": 20.036,
   "dur": 3.028,
   "measured": true,
   "text": "Matches… who will buy my matches?"
  },
  {
   "line": "5",
   "shot": "4",
   "speaker": "NARRATOR",
   "start": 20.336,
   "end": 23.553,
   "dur": 3.217,
   "measured": true,
   "text": "All day, no one had bought a single match."
  },
  {
   "line": "6",
   "shot": "5",
   "speaker": "NARRATOR",
   "start": 24.133,
   "end": 28.303,
   "dur": 4.17,
   "measured": true,
   "text": "Candles gleamed in every window, and it smelled of roast goose."
  },
  {
   "line": "7",
   "shot": "6",
   "speaker": "NARRATOR",
   "start": 29.05,
   "end": 33.641,
   "dur": 4.591,
   "measured": true,
   "text": "She huddled in a corner, afraid to go home: her father would beat her."
  },
  {
   "line": "8",
   "shot": "7",
   "speaker": "NARRATOR",
   "start": 34.342,
   "end": 38.534,
   "dur": 4.192,
   "measured": true,
   "text": "Her hands were numb. If only she dared strike one match…"
  },
  {
   "line": "9",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 40.175,
   "end": 45.044,
   "dur": 4.869,
   "measured": true,
   "text": "How it blazed! It was like sitting by a great, warm iron stove."
  },
  {
   "line": "10",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 45.344,
   "end": 48.874,
   "dur": 3.53,
   "measured": true,
   "text": "Then the flame went out, and the stove was gone."
  },
  {
   "line": "11",
   "shot": "9",
   "speaker": "NARRATOR",
   "start": 49.467,
   "end": 55.572,
   "dur": 6.105,
   "measured": true,
   "text": "She struck another. The wall turned to a veil; inside, a roast goose steamed."
  },
  {
   "line": "12",
   "shot": "10",
   "speaker": "NARRATOR",
   "start": 56.175,
   "end": 59.998,
   "dur": 3.823,
   "measured": true,
   "text": "It hopped down and waddled toward her — and the match went out."
  },
  {
   "line": "13",
   "shot": "11",
   "speaker": "NARRATOR",
   "start": 60.8,
   "end": 65.457,
   "dur": 4.657,
   "measured": true,
   "text": "With the third, she sat beneath a great Christmas tree, ablaze with candles."
  },
  {
   "line": "14",
   "shot": "12",
   "speaker": "NARRATOR",
   "start": 66.133,
   "end": 70.369,
   "dur": 4.236,
   "measured": true,
   "text": "It went out. The lights rose up and became stars. One fell."
  },
  {
   "line": "15",
   "shot": "12",
   "speaker": "GIRL",
   "start": 70.669,
   "end": 72.04,
   "dur": 1.371,
   "measured": true,
   "text": "Someone is dying."
  },
  {
   "line": "16",
   "shot": "13a",
   "speaker": "NARRATOR",
   "start": 72.8,
   "end": 80.974,
   "dur": 8.174,
   "measured": true,
   "text": "Her grandmother, the only one who ever loved her, had told her: when a star falls, a soul goes up to God."
  },
  {
   "line": "17",
   "shot": "13b",
   "speaker": "NARRATOR",
   "start": 81.592,
   "end": 86.373,
   "dur": 4.781,
   "measured": true,
   "text": "One more match — and there stood Grandmother, shining and kind."
  },
  {
   "line": "18",
   "shot": "14",
   "speaker": "GIRL",
   "start": 86.967,
   "end": 89.581,
   "dur": 2.614,
   "measured": true,
   "text": "Grandmother! Take me with you!"
  },
  {
   "line": "19",
   "shot": "15",
   "speaker": "NARRATOR",
   "start": 90.258,
   "end": 93.458,
   "dur": 3.2,
   "measured": true,
   "text": "She struck the whole bundle at once, to keep her near."
  },
  {
   "line": "20",
   "shot": "16",
   "speaker": "NARRATOR",
   "start": 94.217,
   "end": 101.697,
   "dur": 7.48,
   "measured": true,
   "text": "Grandmother took her in her arms, and they flew up, so high — where there is no cold, no hunger, no fear."
  },
  {
   "line": "21",
   "shot": "17",
   "speaker": "NARRATOR",
   "start": 102.3,
   "end": 108.458,
   "dur": 6.158,
   "measured": true,
   "text": "In the cold dawn sat the little girl, rosy-cheeked and smiling — frozen to death."
  },
  {
   "line": "22",
   "shot": "18",
   "speaker": "PASSER-BY",
   "start": 109.092,
   "end": 110.879,
   "dur": 1.787,
   "measured": true,
   "text": "She wanted to warm herself."
  },
  {
   "line": "23",
   "shot": "19",
   "speaker": "NARRATOR",
   "start": 111.55,
   "end": 116.667,
   "dur": 5.117,
   "measured": true,
   "text": "No one knew the beautiful things she had seen, or the joy she had found with her grandmother."
  }
 ],
 "audio": "voice.wav"
