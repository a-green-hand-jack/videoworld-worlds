import base64, json, os, subprocess, sys, urllib.request
url = subprocess.check_output(["ht-resource","url","music"],text=True).strip()
tok = os.environ["HT_RESOURCE_TOKEN"]
def gen(name, prompt):
    out = f"music/{name}"
    if os.path.exists(out+".mp3"): return
    body = json.dumps({"contents":[{"parts":[{"text":prompt}]}]}).encode()
    req = urllib.request.Request(url+"/v1beta/models/lyria-3.5:generateContent", body, {"x-goog-api-key":tok,"Content-Type":"application/json"})
    r = json.load(urllib.request.urlopen(req, timeout=300))
    for p in r["candidates"][0]["content"]["parts"]:
        if "inlineData" in p:
            open(out+".mp3","wb").write(base64.b64decode(p["inlineData"]["data"])); print(name, p["inlineData"]["mimeType"])
        elif "text" in p: print(name, p["text"][:200])
