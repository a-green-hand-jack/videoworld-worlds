 ],
 "srt": "film.srt",
 "out": "cut-v4c.mp4",
 "lines": [
  {
   "line": "1",
   "shot": "1",
   "speaker": "NARRATOR",
   "start": 0.3,
   "end": 5.093,
   "dur": 4.793,
   "measured": true,
   "text": "Bitter cold, almost dark: the last evening of the year."
  },
  {
   "line": "2",
   "shot": "2",
   "speaker": "NARRATOR",
   "start": 6.133,
   "end": 10.026,
   "dur": 3.893,
   "measured": true,
   "text": "A poor girl shuffled along in her mother's big slippers."
  },
  {
   "line": "3",
   "shot": "3",
   "speaker": "NARRATOR",
   "start": 10.758,
   "end": 15.068,
   "dur": 4.31,
   "measured": true,
   "text": "Carriages raced by; she lost them, and went on barefoot."
  },
  {
   "line": "4",
   "shot": "4",
   "speaker": "GIRL",
   "start": 15.675,
   "end": 18.703,
   "dur": 3.028,
   "measured": true,
   "text": "Matches… who will buy my matches?"
  },
  {
   "line": "5",
   "shot": "4",
   "speaker": "NARRATOR",
   "start": 19.003,
   "end": 21.367,
   "dur": 2.364,
   "measured": true,
   "text": "No one had bought a single match."
  },
  {
   "line": "6",
   "shot": "5",
   "speaker": "NARRATOR",
   "start": 21.967,
   "end": 26.424,
   "dur": 4.457,
   "measured": true,
   "text": "Candles gleamed in the windows; it smelled of roast goose."
  },
  {
   "line": "7",
   "shot": "6",
   "speaker": "NARRATOR",
   "start": 27.3,
   "end": 31.421,
   "dur": 4.121,
   "measured": true,
   "text": "She huddled in a corner, afraid to go home to her father."
  },
  {
   "line": "8",
   "shot": "7",
   "speaker": "NARRATOR",
   "start": 32.383,
   "end": 36.74,
   "dur": 4.357,
   "measured": true,
   "text": "Her hands were numb. If she dared strike just one…"
  },
  {
   "line": "9",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 38.342,
   "end": 43.831,
   "dur": 5.489,
   "measured": true,
   "text": "How it blazed! A warm iron stove seemed to stand before her."
  },
  {
   "line": "10",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 44.131,
   "end": 45.754,
   "dur": 1.623,
   "measured": true,
   "text": "Then it went out."
  },
  {
   "line": "11",
   "shot": "9",
   "speaker": "NARRATOR",
   "start": 46.633,
   "end": 53.024,
   "dur": 6.391,
   "measured": true,
   "text": "A second: the wall became a veil, and inside, a roast goose steamed."
  },
  {
   "line": "12",
   "shot": "10",
   "speaker": "NARRATOR",
   "start": 53.633,
   "end": 57.449,
   "dur": 3.816,
   "measured": true,
   "text": "It hopped down and waddled toward her — then darkness."
  },
  {
   "line": "13",
   "shot": "11",
   "speaker": "NARRATOR",
   "start": 58.508,
   "end": 63.64,
   "dur": 5.132,
   "measured": true,
   "text": "A third: she sat beneath a Christmas tree ablaze with candles."
  },
  {
   "line": "14",
   "shot": "12",
   "speaker": "NARRATOR",
   "start": 64.3,
   "end": 70.024,
   "dur": 5.724,
   "measured": true,
   "text": "Out it went. The lights rose and became stars. One fell."
  },
  {
   "line": "15",
   "shot": "12",
   "speaker": "GIRL",
   "start": 70.324,
   "end": 71.695,
   "dur": 1.371,
   "measured": true,
   "text": "Someone is dying."
  },
  {
   "line": "16",
   "shot": "13a",
   "speaker": "NARRATOR",
   "start": 72.3,
   "end": 79.861,
   "dur": 7.561,
   "measured": true,
   "text": "Her grandmother, the only one who had loved her, had said: a falling star is a soul going to God."
  },
  {
   "line": "17",
   "shot": "13b",
   "speaker": "NARRATOR",
   "start": 80.467,
   "end": 85.325,
   "dur": 4.858,
   "measured": true,
   "text": "A fourth — and there stood Grandmother, shining and kind."
  },
  {
   "line": "18",
   "shot": "14",
   "speaker": "GIRL",
   "start": 85.925,
   "end": 88.539,
   "dur": 2.614,
   "measured": true,
   "text": "Grandmother! Take me with you!"
  },
  {
   "line": "19",
   "shot": "15",
   "speaker": "NARRATOR",
   "start": 90.175,
   "end": 93.734,
   "dur": 3.559,
   "measured": true,
   "text": "She struck the whole bundle, to keep her near."
  },
  {
   "line": "20",
   "shot": "16",
   "speaker": "NARRATOR",
   "start": 94.55,
   "end": 102.011,
   "dur": 7.461,
   "measured": true,
   "text": "Grandmother took her in her arms, and they flew up, where there is no cold, no hunger, no fear."
  },
  {
   "line": "21",
   "shot": "17",
   "speaker": "NARRATOR",
   "start": 102.592,
   "end": 109.176,
   "dur": 6.584,
   "measured": true,
   "text": "At dawn she sat there still, rosy-cheeked and smiling — frozen to death."
  },
  {
   "line": "22",
   "shot": "18",
   "speaker": "PASSER-BY",
   "start": 109.758,
   "end": 111.545,
   "dur": 1.787,
   "measured": true,
   "text": "She wanted to warm herself."
  },
  {
   "line": "23",
   "shot": "19",
   "speaker": "NARRATOR",
   "start": 113.758,
   "end": 118.653,
   "dur": 4.895,
   "measured": true,
   "text": "No one knew the beautiful things she had seen, or the joy she had gone to."
  }
 ],
