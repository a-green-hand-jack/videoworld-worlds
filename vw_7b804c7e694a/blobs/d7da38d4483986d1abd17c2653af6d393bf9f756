#!/usr/bin/env python3
"""Regenerate shot-log.md from tools/shots.py, shots/ and tools/status.json (take/release per shot)."""
import sys, json, subprocess, os
sys.path.insert(0, os.path.dirname(__file__))
from shots import S
st = json.load(open("tools/status.json"))
rows = []
for sid, s in S.items():
    f = f"shots/{sid}.mp4"
    dur = float(subprocess.check_output(["ffprobe","-v","error","-show_entries","format=duration","-of","csv=p=0",f]))
    x = st[sid]
    rows.append(f"| {sid} | `{f}` | {dur:.2f} s | {s['kf'].split(':')[-1][:0]}{s['motion']} | direction/shot-list.md row {sid.rstrip('ab').lstrip('s').lstrip('0')}; design refs {', '.join(s['refs'])} | {x['take']} | {x['release']} | {x['note']} |")
head = """# Shot log (dp)

Current take of each shot id is `shots/<id>.mp4` in this repository (1280x720, 24 fps, H.264 + AAC; the model's own sound track is kept untouched).
Key frame per shot: `keyframes/<id>.png`. Prompts: `tools/shots.py` (key frame + motion) and `shots/<id>.prompt.txt` (the exact video prompt sent).
Every shot is made from the production-designer's `design-v1` references and the director's `direction/shot-list.md` (shot 13 is split in two: s13a face/flare, s13b grandmother revealed, 7 s + 8 s for the 13.1 s slot).
Takes: `model` = generated by video-generation from key frame + refs; `still-push` = interim: the key frame with a slow push-in made with ffmpeg, to be replaced by a model shot.

| shot | file | duration | motion / what it shows | direction and design followed | take | release | note |
|---|---|---|---|---|---|---|---|
"""
open("shot-log.md","w").write(head + "\n".join(rows) + "\n")
