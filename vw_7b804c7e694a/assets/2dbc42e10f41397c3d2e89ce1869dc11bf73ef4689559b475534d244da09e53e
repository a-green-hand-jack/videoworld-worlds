   "end": 4.667,
   "dur": 4.366666666666667,
   "measured": false,
   "text": "Bitter cold, almost dark: the last evening of the year."
  },
  {
   "line": "2",
   "shot": "2",
   "speaker": "NARRATOR",
   "start": 5.55,
   "end": 9.917,
   "dur": 4.366666666666667,
   "measured": false,
   "text": "A poor girl shuffled along in her mother's big slippers."
  },
  {
   "line": "3",
   "shot": "3",
   "speaker": "NARRATOR",
   "start": 10.508,
   "end": 14.875,
   "dur": 4.366666666666667,
   "measured": false,
   "text": "Carriages raced by; she lost them, and went on barefoot."
  },
  {
   "line": "4",
   "shot": "4",
   "speaker": "GIRL",
   "start": 15.467,
   "end": 17.75,
   "dur": 2.2833333333333337,
   "measured": false,
   "text": "Matches… who'll buy my matches?"
  },
  {
   "line": "5",
   "shot": "4",
   "speaker": "NARRATOR",
   "start": 18.05,
   "end": 21.167,
   "dur": 3.116666666666667,
   "measured": false,
   "text": "No one had bought a single match."
  },
  {
   "line": "6",
   "shot": "5",
   "speaker": "NARRATOR",
   "start": 21.758,
   "end": 26.125,
   "dur": 4.366666666666667,
   "measured": false,
   "text": "Candles gleamed in the windows; it smelled of roast goose."
  },
  {
   "line": "7",
   "shot": "6",
   "speaker": "NARRATOR",
   "start": 26.883,
   "end": 32.083,
   "dur": 5.2,
   "measured": false,
   "text": "She huddled in a corner, afraid to go home to her father."
  },
  {
   "line": "8",
   "shot": "7",
   "speaker": "NARRATOR",
   "start": 32.717,
   "end": 37.083,
   "dur": 4.366666666666667,
   "measured": false,
   "text": "Her hands were numb. If she dared strike just one…"
  },
  {
   "line": "9",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 38.675,
   "end": 43.875,
   "dur": 5.2,
   "measured": false,
   "text": "How it blazed! A warm iron stove seemed to stand before her."
  },
  {
   "line": "10",
   "shot": "8",
   "speaker": "NARRATOR",
   "start": 44.175,
   "end": 46.042,
   "dur": 1.8666666666666667,
   "measured": false,
   "text": "Then it went out."
  },
  {
   "line": "11",
   "shot": "9",
   "speaker": "NARRATOR",
   "start": 46.8,
   "end": 52.417,
   "dur": 5.616666666666667,
   "measured": false,
   "text": "A second: the wall became a veil, and inside, a roast goose steamed."
  },
  {
   "line": "12",
   "shot": "10",
   "speaker": "NARRATOR",
   "start": 53.008,
   "end": 56.958,
   "dur": 3.95,
   "measured": false,
   "text": "It hopped down and waddled toward her — then darkness."
  },
  {
   "line": "13",
   "shot": "11",
   "speaker": "NARRATOR",
   "start": 57.758,
   "end": 62.542,
   "dur": 4.783333333333334,
   "measured": false,
   "text": "A third: she sat beneath a Christmas tree ablaze with candles."
  },
  {
   "line": "14",
   "shot": "12",
   "speaker": "NARRATOR",
   "start": 63.217,
   "end": 68.0,
   "dur": 4.783333333333334,
   "measured": false,
   "text": "Out it went. The lights rose and became stars. One fell."
  },
  {
   "line": "15",
   "shot": "12",
   "speaker": "GIRL",
   "start": 68.3,
   "end": 69.75,
   "dur": 1.45,
   "measured": false,
   "text": "Someone is dying."
  },
  {
   "line": "16",
   "shot": "13a",
   "speaker": "NARRATOR",
   "start": 70.467,
   "end": 79.0,
   "dur": 8.533333333333333,
   "measured": false,
   "text": "Her grandmother, the only one who had loved her, had said: a falling star is a soul going to God."
  },
  {
   "line": "17",
   "shot": "13b",
   "speaker": "NARRATOR",
   "start": 79.592,
   "end": 83.542,
   "dur": 3.95,
   "measured": false,
   "text": "A fourth — and there stood Grandmother, shining and kind."
  },
  {
   "line": "18",
   "shot": "14",
   "speaker": "GIRL",
   "start": 84.217,
   "end": 86.5,
   "dur": 2.2833333333333337,
   "measured": false,
   "text": "Grandmother! Take me with you!"
  },
  {
   "line": "19",
   "shot": "15",
   "speaker": "NARRATOR",
   "start": 87.258,
   "end": 91.208,
   "dur": 3.95,
   "measured": false,
   "text": "She struck the whole bundle, to keep her near."
  },
  {
   "line": "20",
   "shot": "16",
   "speaker": "NARRATOR",
   "start": 91.883,
   "end": 100.0,
   "dur": 8.116666666666667,
   "measured": false,
   "text": "Grandmother took her in her arms, and they flew up, where there is no cold, no hunger, no fear."
  },
  {
   "line": "21",
   "shot": "17",
   "speaker": "NARRATOR",
   "start": 100.592,
   "end": 106.208,
   "dur": 5.616666666666667,
   "measured": false,
   "text": "At dawn she sat there still, rosy-cheeked and smiling — frozen to death."
  },
  {
   "line": "22",
   "shot": "18",
   "speaker": "PASSER-BY",
   "start": 106.925,
   "end": 109.208,
   "dur": 2.2833333333333337,
   "measured": false,
   "text": "She wanted to warm herself."
  },
  {
   "line": "23",
   "shot": "19",
   "speaker": "NARRATOR",
   "start": 109.842,
   "end": 116.708,
   "dur": 6.866666666666667,
   "measured": false,
   "text": "No one knew the beautiful things she had seen, or the joy she had gone to."
  }
 ]
