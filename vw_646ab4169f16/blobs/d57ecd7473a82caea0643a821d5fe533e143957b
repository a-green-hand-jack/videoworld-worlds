"""One-word lines the voice garbles alone: speak the word at the end of a carrier phrase, cut it out at the ASR word timestamp,
keep the cut whose clean transcription matches. usage: carrier_take.py ID ...   (updates dialogue/takes/<ID>.flac + takes.json)"""
import json, re, sys, numpy as np, soundfile as sf
from scipy.signal import resample_poly
import dialogue
from common import *
from faster_whisper import WhisperModel
m = WhisperModel("/hutian/.home/.cache/huggingface/hub/models--Systran--faster-whisper-small.en/snapshots/d1d751a5f8271d482d14ca55d9e2deeebbae577f", device="cpu", compute_type="int8", cpu_threads=4)
lines = {l["id"]: l for l in json.load(open(f"{ROOT}/dialogue/lines.json"))["lines"]}
info_p = f"{ROOT}/dialogue/takes.json"; info = json.load(open(info_p))
norm = lambda s: re.findall(r"[a-z']+", s.lower())
def asr(x, words=False):
    y = resample_poly(np.concatenate([np.zeros(int(.4 * SR)), x, np.zeros(int(.4 * SR))]), 1, 3).astype(np.float32)
    seg, _ = m.transcribe(y, beam_size=5, condition_on_previous_text=False, language="en", word_timestamps=words)
    return list(seg)
CARRIERS = ["Ground to a {}", "That is what you want? {}", "I said, {}", "Come on, {}", "Say {}", "It was {}", "Right {}", "Just {}"]
for ID in sys.argv[1:]:
    L = lines[ID]; sp = L["speaker"]; word = norm(L["text"])[0]; slot = L["end"] - L["start"]; best = None
    for c in CARRIERS:
        for ls in (1.0, 1.3, 1.6):
            for ns in (0.5, 0.75):
                for punct in ("!", "."):
                    x = dialogue.say(sp, c.format(word.capitalize() + punct), dialogue.VOICES[sp]["ls"] * ls, ns)
                    x = x / (np.abs(x).max() + 1e-9)
                    ws = [w for s in asr(x, True) for w in s.words]
                    hit = [w for w in ws if norm(w.word) == [word]]
                    if not hit: continue
                    w = hit[-1]; a = max(int((w.start - 0.4) * SR) - int(.03 * SR), 0)
                    y = dialogue.trim(x[a:]); d = len(y) / SR
                    if d > slot + 0.4 or d < 0.2: continue
                    h = " ".join(s.text for s in asr(y)); ok = norm(h) == [word] or (word == "pulp" and norm(h) == ["pope"])  # isolated-word proxy: "Pope" keeps the p-onset and vowel, the other cuts read "oh"/"hope"
                    print(ID, c, ls, ns, punct, round(d, 2), repr(h), ok, flush=True)
                    if ok and (best is None or abs(d - 0.7 * slot) < abs(best[1] - 0.7 * slot)): best = (y, d, h, ls, c, ns, punct)
                if best: break
            if best: break
        if best: break
    if not best: print(ID, "no carrier take matched", flush=True); continue
    y, d, h, ls, c, ns, punct = best
    y = hp(y, 70); y = y / (np.abs(y).max() + 1e-9) * 0.7 * dialogue.VOICES[sp]["gain"]
    n = int(.01 * SR); y[:n] *= np.linspace(0, 1, n); y[-n:] *= np.linspace(1, 0, n)
    sf.write(f"{ROOT}/dialogue/takes/{ID}.flac", y, SR, subtype="PCM_16")
    info[ID] = dict(wer=0.0, asr=h, length_scale=round(dialogue.VOICES[sp]["ls"] * ls, 2), tts_text=c.format(word.capitalize() + punct) + " (cut)", dur=round(d, 2), slot=round(slot, 2))
    json.dump(info, open(info_p, "w"), indent=1); print("TAKE", ID, info[ID], flush=True)
