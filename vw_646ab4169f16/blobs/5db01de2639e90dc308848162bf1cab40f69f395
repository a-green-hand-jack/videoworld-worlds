"""L31 'Pulp!' respellings and consonant lift, scored on the real v2 bed with tight windows. usage: sweep_pulp.py MIX.wav DIALOGUE.wav"""
import re, sys, numpy as np, soundfile as sf
from scipy.signal import resample_poly
import dialogue
from common import *
from faster_whisper import WhisperModel
m = WhisperModel("/hutian/.home/.cache/huggingface/hub/models--Systran--faster-whisper-small.en/snapshots/d1d751a5f8271d482d14ca55d9e2deeebbae577f", device="cpu", compute_type="int8", cpu_threads=4)
mix, _ = sf.read(sys.argv[1]); dlg, _ = sf.read(sys.argv[2])
t0, slot = 291.0, 0.4
a, b = int((t0 - 1) * SR), int((t0 + slot + 1.5) * SR); bed = (mix[a:b] - dlg[a:b]).mean(1)
f = np.abs(dlg[int(t0 * SR):int((t0 + slot) * SR)].mean(1)).max() / 0.7
norm = lambda s: re.findall(r"[a-z']+", s.lower())
def asr(x):
    seg, _ = m.transcribe(resample_poly(x, 1, 3).astype(np.float32), beam_size=5, condition_on_previous_text=False, language="en")
    return " ".join(s.text for s in seg).strip()
def lift(y, db):  # consonant lift: 2-6 kHz band added back
    return y + bp(y, 2000, 6000) * (10 ** (db / 20) - 1)
res = []
TX = ["Pulp!", "Pulp.", "Puhlp!", "Pulpp!", "Pull-p!", "Pulp, pulp!", "Pulp pulp.", "A pulp!", "Pulp!!"]
for txt in TX:
    for ls in (1.0, 1.3, 1.6, 2.0):
        for ns in (0.5, 0.75, 1.0):
            x = dialogue.say("Proog", txt, dialogue.VOICES["Proog"]["ls"] * ls, ns)
            if "," in txt or " pulp" in txt:  # keep the second word only
                e = np.abs(x) > 0.02 * np.abs(x).max(); idx = np.where(e)[0]
                gaps = np.where(np.diff(idx) > 0.08 * SR)[0]
                if not len(gaps): continue
                x = x[idx[gaps[-1] + 1]:]
            y = dialogue.trim(x); d = len(y) / SR
            if d < .3 or d > 0.95: continue
            for db in (0, 6, 10):
                z = lift(y, db) if db else y
                z = hp(z, 70); z = z / (np.abs(z).max() + 1e-9) * 0.7
                k = int(.01 * SR); z[:k] *= np.linspace(0, 1, k); z[-k:] *= np.linspace(1, 0, k)
                w = bed.copy(); i = SR; w[i:i + len(z)] += z * f
                o = [asr(w[int((1 - p) * SR):i + len(z) + int(p * SR)]) for p in (0.3, 0.6, 1.0)]
                sc = sum(norm(h) == ["pulp"] for h in o)
                print(txt, ls, ns, db, round(d, 2), o, flush=True); res.append((sc, -abs(d - .6), txt, ls, ns, db, d, z))
res.sort(key=lambda r: r[:2], reverse=True)
for j, r in enumerate(res[:5]):
    sf.write(f"/hutian/work/sweep/L31p_{j}.flac", r[7], SR, subtype="PCM_16"); print("TOP", j, r[:7], flush=True)
print("HUTIAN_WAKE: pulp sweep done", flush=True)
