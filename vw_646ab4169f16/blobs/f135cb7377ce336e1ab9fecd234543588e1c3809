import numpy as np
from common import *

def noise(n, rng): return rng.standard_normal(n)

def metal_hit(rng, f0=None, dur=1.5, bright=1.0):
    f0 = f0 or rng.uniform(180, 900)
    n = int(dur * SR); t = np.arange(n) / SR
    y = np.zeros(n)
    for r, a in zip((1, 2.76, 5.4, 8.93, 11.3), (1, .7, .5, .3, .2)):
        y += a * np.sin(2 * np.pi * f0 * r * t * (1 + .002 * rng.standard_normal())) * np.exp(-t * (3 + 2.5 * r) / dur * 2)
    y += hp(noise(n, rng), 2000) * np.exp(-t * 80) * 0.5 * bright
    return y / np.abs(y).max()

def click(rng, f=None):
    n = int(0.06 * SR); t = np.arange(n) / SR
    f = f or rng.uniform(1500, 4000)
    return bp(noise(n, rng), f * .7, f * 1.3) * np.exp(-t * 120)

def boom(rng, dur=4.0, f=40):
    n = int(dur * SR); t = np.arange(n) / SR
    fr = f + 60 * np.exp(-t * 8)
    y = np.sin(2 * np.pi * np.cumsum(fr) / SR) * np.exp(-t * 1.2)
    y += lp(noise(n, rng), 400) * np.exp(-t * 2.5)
    return y

def swell(rng, dur, lo=200, hi=3000):
    n = int(dur * SR); t = np.arange(n) / SR
    y = bp(noise(n, rng), lo, hi) * (np.sin(np.pi * t / dur) ** 2)
    return y

def bird(rng):
    dur = rng.uniform(.25, .6); n = int(dur * SR); t = np.arange(n) / SR
    f = rng.uniform(2200, 3800) * (1 + .25 * np.sin(2 * np.pi * rng.uniform(6, 14) * t))
    return np.sin(2 * np.pi * np.cumsum(f) / SR) * np.sin(np.pi * t / dur) ** 2 * .5

def phone_ring(dur=2.0):
    n = int(dur * SR); t = np.arange(n) / SR
    y = (np.sin(2 * np.pi * 440 * t) + np.sin(2 * np.pi * 480 * t)) * .5
    y *= (np.sin(2 * np.pi * 20 * t) > 0) * 1.0
    y *= (t < 0.9) | ((t > 1.1) & (t < 2.0 - 0.1))
    return lp(y, 3000)

def alarm(dur=6.0):
    n = int(dur * SR); t = np.arange(n) / SR
    f = np.where((t * 2) % 1 < .5, 880, 660)
    y = np.sign(np.sin(2 * np.pi * np.cumsum(f) / SR)) * .3
    return lp(y, 3500)

def footstep(rng):
    n = int(0.25 * SR); t = np.arange(n) / SR
    return lp(noise(n, rng), 600) * np.exp(-t * 28) + .4 * np.sin(2 * np.pi * 70 * t) * np.exp(-t * 25)


def whoosh(rng, dur=1.0, lo=300, hi=5000):
    n = int(dur * SR); t = np.arange(n) / SR
    env = np.sin(np.pi * np.clip(t / dur, 0, 1)) ** 1.5
    return bp(noise(n, rng), lo, hi) * env

def boing(rng, f=300):
    n = int(0.6 * SR); t = np.arange(n) / SR
    fr = f * (1 + 0.5 * np.exp(-t * 14) * np.sin(2 * np.pi * 14 * t))
    return np.sin(2 * np.pi * np.cumsum(fr) / SR) * np.exp(-t * 7) * .6

def tone(dur, f=6200):
    n = int(dur * SR); t = np.arange(n) / SR
    return np.sin(2 * np.pi * f * t) * np.sin(np.pi * t / dur) ** 2 * .15

def fan(rng, dur):
    n = int(dur * SR); t = np.arange(n) / SR
    y = lp(noise(n, rng), 250) * (0.6 + 0.4 * np.sin(2 * np.pi * 5.5 * t)) + .3 * np.sin(2 * np.pi * 55 * t)
    e = np.minimum(1, np.minimum(t / 2, (dur - t) / 2))
    return y * e * .6

def musicbox(rng, dur):
    notes = [74, 77, 81, 79, 77, 74, 72, 74, 77, 76, 72, 69]
    n = int(dur * SR); y = np.zeros(n); step = 0.7
    for k in range(int(dur / step)):
        f = 440 * 2 ** ((notes[k % len(notes)] - 69) / 12); ln = int(1.4 * SR); tl = np.arange(ln) / SR
        c = (np.sin(2 * np.pi * f * tl) + .3 * np.sin(2 * np.pi * f * 3.01 * tl)) * np.exp(-tl * 3.2)
        o = int(k * step * SR); y[o:o + ln] += c[: n - o][: ln]
    return y * np.minimum(1, np.minimum(np.arange(n) / SR / 1.5, (dur - np.arange(n) / SR) / 1.5)) * .5

def ticks(rng, dur, density=9):
    n = int(dur * SR); y = np.zeros(n)
    for _ in range(int(dur * density)):
        c = click(rng, rng.uniform(900, 3500)); o = int(rng.uniform(0, dur - .08) * SR); y[o:o + len(c)] += c * rng.uniform(.4, 1)
    return y

def make_effects(dur, events=(), seed=11):
    """events: list of {t, type, ...} placed explicitly; beds + random machinery follow intensity."""
    rng = np.random.default_rng(seed)
    n = int(dur * SR); t = np.arange(n) / SR
    I = intensity(dur, 4.0)
    E = np.zeros((2, n))
    # machine hum bed: mains hum harmonics + filtered noise, slow breathing
    hum = sum(a * np.sin(2 * np.pi * f * t + rng.random() * 6) for f, a in ((50, 1), (100, .5), (150, .25), (250, .1)))
    br = 0.6 + 0.4 * np.sin(2 * np.pi * t / 17.0)
    bed = lp(np.stack([noise(n, rng), noise(n, rng)]), 700) * 0.5
    E += (bed + hum[None] * .15) * br * (0.10 + 0.12 * I)
    # air/wind
    wind = hp(lp(np.stack([noise(n, rng), noise(n, rng)]), 1800), 250) * (0.5 + 0.5 * np.sin(2 * np.pi * t / 31 + 1)) ** 2
    E += wind * 0.05 * (0.4 + I)
    # clockwork ticking when machine is busy
    k = 0; tt = 3.0
    while tt < dur:
        iv = I[int(tt * SR)]
        if iv > 0.3:
            period = 0.5 - 0.25 * iv
            add(E, pan(click(rng) * (0.12 + 0.2 * iv), rng.uniform(-.8, .8)), tt)
            tt += period * (1 + 0.04 * rng.standard_normal())
        else:
            tt += 0.7
    # clanks/hits with density following intensity
    tt = 4.0
    while tt < dur:
        iv = I[int(tt * SR)]
        gap = rng.exponential(9 - 7 * iv)
        tt += max(.8, gap)
        if tt >= dur: break
        add(E, pan(metal_hit(rng) * (0.1 + 0.25 * iv), rng.uniform(-.9, .9)), tt)
    # distant swells
    tt = 10.0
    while tt < dur:
        d = rng.uniform(4, 9)
        add(E, pan(swell(rng, d) * (0.08 + 0.2 * I[int(tt * SR)]), rng.uniform(-.7, .7)), tt)
        tt += rng.uniform(14, 30)
    # explicit events
    for ev in events:
        ty = ev["type"]; g = ev.get("gain", 1.0); p = ev.get("pan", 0.0)
        if ty == "boom": y = boom(rng, ev.get("dur", 4.0)) * .8
        elif ty == "crash":
            y = boom(rng, 3.5) * .7; m = metal_hit(rng, 120, 3.0) * .6; y[:len(m)] += m
        elif ty == "metal": y = metal_hit(rng, ev.get("f"), ev.get("dur", 1.5))
        elif ty == "birds":
            d = ev.get("dur", 4); y = np.zeros(int(d * SR))
            for _ in range(int(d * 2)):
                c = bird(rng); o = int(rng.uniform(0, d - .7) * SR); y[o:o + len(c)] += c
        elif ty == "phone": y = phone_ring()
        elif ty == "alarm": y = alarm(ev.get("dur", 6))
        elif ty == "steps":
            y = np.zeros(int(ev.get("dur", 4) * SR))
            for s in np.arange(0, ev.get("dur", 4) - .3, ev.get("period", .55)): y[int(s * SR):int(s * SR) + int(.25 * SR)] += footstep(rng)[: len(y[int(s * SR):int(s * SR) + int(.25 * SR)])]
        elif ty == "swell": y = swell(rng, ev.get("dur", 5), ev.get("lo", 200), ev.get("hi", 3000))
        elif ty == "whoosh": y = whoosh(rng, ev.get("dur", 1.0), ev.get("lo", 300), ev.get("hi", 5000))
        elif ty == "boing": y = boing(rng, ev.get("f", 300))
        elif ty == "tone": y = tone(ev.get("dur", 6), ev.get("f", 6200))
        elif ty == "fan": y = fan(rng, ev.get("dur", 20))
        elif ty == "musicbox": y = musicbox(rng, ev.get("dur", 8))
        elif ty == "ticks": y = ticks(rng, ev.get("dur", 3), ev.get("density", 9))
        elif ty == "click": y = click(rng, ev.get("f")) * 3
        else: continue
        add(E, pan(y * g * .5, p), ev["t"])
    E = reverb(E, 1.8, 0.2, seed=5)
    f = int(1.0 * SR)
    E[:, :f] *= np.linspace(0, 1, f); E[:, -f:] *= np.linspace(1, 0, f)
    return E
