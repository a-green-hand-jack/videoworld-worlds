#!/usr/bin/env python3
"""Measure decoded per-frame luma changes in DP picture clips."""

import argparse
import json
import subprocess
from pathlib import Path

import imageio_ffmpeg
import numpy as np


WIDTH = 1024
HEIGHT = 576
FPS = 24


def measure(path: Path, threshold: float) -> dict:
    command = [
        imageio_ffmpeg.get_ffmpeg_exe(),
        "-hide_banner",
        "-loglevel",
        "error",
        "-i",
        str(path),
        "-vf",
        "format=gray",
        "-f",
        "rawvideo",
        "pipe:1",
    ]
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    frame_bytes = WIDTH * HEIGHT
    previous = None
    frames = 0
    changed_pairs = 0
    for _ in iter(int, 1):
        payload = process.stdout.read(frame_bytes)
        if not payload:
            break
        if len(payload) != frame_bytes:
            process.kill()
            raise RuntimeError(f"partial frame in {path}: {len(payload)} bytes")
        current = np.frombuffer(payload, dtype=np.uint8).astype(np.float32)
        if previous is not None and float(np.abs(current - previous).mean()) > threshold:
            changed_pairs += 1
        previous = current
        frames += 1
    stderr = process.stderr.read().decode(errors="replace")
    result = process.wait()
    if result != 0:
        raise RuntimeError(f"ffmpeg failed for {path}: {stderr[-500:]}")
    return {
        "asset": str(path),
        "frames": frames,
        "fps": FPS,
        "threshold_luma": threshold,
        "changed_pairs": changed_pairs,
        "distinct_pictures": changed_pairs + (1 if frames else 0),
        "new_pictures_per_second": round(changed_pairs / (frames / FPS), 3) if frames else 0.0,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("assets", nargs="+", type=Path)
    parser.add_argument("--threshold", type=float, default=0.3)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    results = [measure(path, args.threshold) for path in args.assets]
    text = json.dumps({"schema": 1, "measurements": results}, indent=2) + "\n"
    if args.output:
        args.output.write_text(text)
    else:
        print(text, end="")


if __name__ == "__main__":
    main()
