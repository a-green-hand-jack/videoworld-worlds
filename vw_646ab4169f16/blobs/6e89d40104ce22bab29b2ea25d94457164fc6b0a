#!/usr/bin/env python3
"""Assemble a cut from edit/timeline.json.
usage: assemble.py --timeline T --out DIR [--shots MAP.json] [--audio WAV] [--vtt FILE] [--credits TXT] [--label NAME]
MAP.json: {"S002": "/path/S002.mp4" or "/path/frames_dir", ...}; a shot without a file becomes a labelled slate.
Writes DIR/film.mp4 (+ DIR/subtitles.vtt if given) and DIR/assembly.json (provenance)."""
import argparse, json, os, subprocess, textwrap, hashlib, shutil
import numpy as np
from PIL import Image, ImageDraw, ImageFont
FF = '/hutian/.mamba/bin/ffmpeg'; FP = '/hutian/.mamba/bin/ffprobe'
FONT = '/hutian/.mamba/fonts/DejaVuSans.ttf'
W, H, FPS = 1024, 576, 24
ap = argparse.ArgumentParser()
ap.add_argument('--timeline', required=True); ap.add_argument('--out', required=True)
ap.add_argument('--shots'); ap.add_argument('--audio'); ap.add_argument('--vtt'); ap.add_argument('--credits')
ap.add_argument('--label', default='cut'); ap.add_argument('--work', default='/hutian/work/build')
a = ap.parse_args()
tl = json.load(open(a.timeline)); shots = tl['shots']
smap = json.load(open(a.shots)) if a.shots else {}
os.makedirs(a.out, exist_ok=True); seg = os.path.join(a.work, a.label); os.makedirs(seg, exist_ok=True)
ENC = ['-c:v', 'libx264', '-preset', 'medium', '-crf', '18', '-pix_fmt', 'yuv420p', '-profile:v', 'high', '-r', str(FPS), '-g', '48', '-bf', '2']
def run(cmd): subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
def font(n): return ImageFont.truetype(FONT, n)
def tc(f): return f"{f//(3600*FPS):02d}:{f//(60*FPS)%60:02d}:{f//FPS%60:02d}:{f%FPS:02d}"
def slate(s, path):
    im = Image.new('RGB', (W, H), (28, 28, 30)); d = ImageDraw.Draw(im)
    d.text((40, 30), f"{s['id']}  ·  {s.get('scene','')}  ·  MISSING PICTURE", font=font(30), fill=(230, 200, 90))
    d.text((40, 76), f"{tc(s['frame_in'])} – {tc(s['frame_out'])}   {s['frames']} frames / {s['seconds']:.2f} s", font=font(22), fill=(200, 200, 200))
    y = 130
    for line in textwrap.wrap(s.get('what') or '', 70)[:8]: d.text((40, y), line, font=font(22), fill=(235, 235, 235)); y += 30
    y += 10
    for dl in s.get('dialogue', [])[:6]:
        for line in textwrap.wrap(f"{dl.get('speaker','')}: {dl.get('text','')}", 76)[:2]: d.text((40, y), line, font=font(20), fill=(150, 200, 255)); y += 26
    im.save(path)
def credits_png(txt, path):
    lines = open(txt).read().split('\n'); lh = 34
    hh = H + len(lines) * lh + H
    im = Image.new('RGB', (W, hh), (0, 0, 0)); d = ImageDraw.Draw(im); y = H
    for l in lines:
        big = l.startswith('# '); t = l[2:] if big else l
        f = font(34 if big else 24); w = d.textlength(t, font=f)
        d.text(((W - w) / 2, y), t, font=f, fill=(255, 255, 255) if big else (215, 215, 215)); y += lh + (10 if big else 0)
    im = im.crop((0, 0, W, y + H)); im.save(path); return im.size[1]
def title_png(ov, path):
    im = Image.new('RGBA', (W, H), (0, 0, 0, 0)); d = ImageDraw.Draw(im)
    f = ImageFont.truetype(ov.get('font', TITLEFONT), ov.get('size', 64)); y = ov.get('y', 0.45) * H
    for line in ov['text'].split('\n'):
        w = d.textlength(line, font=f); x = (W - w) / 2
        for dx, dy in ((2, 3), (1, 2)): d.text((x + dx, y + dy), line, font=f, fill=(0, 0, 0, 170))
        d.text((x, y), line, font=f, fill=tuple(ov.get('color', (232, 222, 196))) + (255,)); y += f.size * 1.25
    im.save(path)
TITLEFONT = '/hutian/.mamba/fonts/Ubuntu-L.ttf'
segs = []; prov = []
for s in shots:
    n = s['frames']; out = os.path.join(seg, f"{s['id']}.mp4"); src = smap.get(s['id'])
    if s['id'] == tl.get('credits_shot', 'S127') and a.credits:
        png = os.path.join(seg, 'credits.png'); ch = credits_png(a.credits, png)
        dur = n / FPS; speed = (ch - H) / dur
        run([FF, '-y', '-loop', '1', '-i', png, '-vf', f"crop={W}:{H}:0:'min({ch-H},t*{speed:.4f})',fps={FPS}", '-frames:v', str(n), *ENC, '-an', out])
        kind = 'credits'
    elif src and os.path.exists(src):
        if os.path.isdir(src):
            inp = ['-framerate', str(FPS), '-pattern_type', 'glob', '-i', os.path.join(src, '*.png')]
        else:
            inp = ['-i', src]
        # exact frame count: pad by holding the last frame if short, cut if long
        run([FF, '-y', *inp, '-vf', f"scale={W}:{H}:force_original_aspect_ratio=decrease,pad={W}:{H}:(ow-iw)/2:(oh-ih)/2,setsar=1,fps={FPS},tpad=stop_mode=clone:stop=-1", '-frames:v', str(n), *ENC, '-an', out])
        kind = 'shot'
    else:
        png = os.path.join(seg, f"{s['id']}.png"); slate(s, png)
        run([FF, '-y', '-loop', '1', '-i', png, '-vf', f"fps={FPS}", '-frames:v', str(n), *ENC, '-an', out])
        kind = 'slate'
    if s.get('overlays'):
        base = out.replace('.mp4', '_base.mp4'); os.replace(out, base)
        ins = ['-i', base]; fc = []; last = '0:v'
        for k, ov in enumerate(s['overlays']):
            png = os.path.join(seg, f"{s['id']}_ov{k}.png"); title_png(ov, png)
            ins += ['-loop', '1', '-i', png]; st, en, fd = ov['start'], ov['end'], ov.get('fade', 1.0)
            fc.append(f"[{k+1}:v]format=rgba,fade=in:st={st}:d={fd}:alpha=1,fade=out:st={en-fd}:d={fd}:alpha=1[o{k}]")
            fc.append(f"[{last}][o{k}]overlay=0:0:shortest=1:enable='between(t,{st},{en})'[v{k}]"); last = f"v{k}"
        run([FF, '-y', *ins, '-filter_complex', ';'.join(fc), '-map', f'[{last}]', '-frames:v', str(n), *ENC, '-an', out])
        kind += '+title'
    if s.get('gain'):
        # edit fades and dips: per-frame gain from [frame, gain] keys, linearly interpolated
        g = np.interp(np.arange(n), *zip(*s['gain']['keys']))
        base = out.replace('.mp4', '_nogain.mp4'); os.replace(out, base)
        dec = subprocess.Popen([FF, '-v', 'error', '-i', base, '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-'], stdout=subprocess.PIPE)
        enc = subprocess.Popen([FF, '-v', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-s', f'{W}x{H}', '-r', str(FPS), '-i', '-', *ENC, '-an', out], stdin=subprocess.PIPE)
        for i in range(n):
            f = np.frombuffer(dec.stdout.read(W * H * 3), np.uint8)
            enc.stdin.write((f.astype(np.float32) * g[i] + 0.5).astype(np.uint8).tobytes())
        enc.stdin.close(); enc.wait(); dec.wait()
        kind += '+gain'
    got = int(subprocess.run([FP, '-v', 'error', '-count_frames', '-select_streams', 'v', '-show_entries', 'stream=nb_read_frames', '-of', 'csv=p=0', out], capture_output=True, text=True).stdout.strip())
    assert got == n, (s['id'], got, n)
    segs.append(out); prov.append({'id': s['id'], 'kind': kind, 'source': src if kind.startswith('shot') else None, 'frames': n})
    print(s['id'], kind, n, flush=True)
lst = os.path.join(seg, 'concat.txt'); open(lst, 'w').write(''.join(f"file '{p}'\n" for p in segs))
vid = os.path.join(seg, 'video.mp4'); run([FF, '-y', '-f', 'concat', '-safe', '0', '-i', lst, '-c', 'copy', vid])
film = os.path.join(a.out, 'film.mp4'); total = tl['total_frames']
if a.audio:
    run([FF, '-y', '-i', vid, '-i', a.audio, '-map', '0:v', '-map', '1:a', '-c:v', 'copy', '-c:a', 'aac', '-b:a', '192k', '-ar', '48000', '-ac', '2',
         '-af', f"apad,atrim=0:{total/FPS}", '-movflags', '+faststart', film])
else:
    run([FF, '-y', '-i', vid, '-f', 'lavfi', '-i', 'anullsrc=r=48000:cl=stereo', '-map', '0:v', '-map', '1:a', '-c:v', 'copy', '-c:a', 'aac', '-b:a', '192k', '-t', f"{total/FPS}", '-movflags', '+faststart', film])
if a.vtt: shutil.copy(a.vtt, os.path.join(a.out, 'subtitles.vtt'))
json.dump({'label': a.label, 'timeline_version': tl.get('version'), 'audio': a.audio, 'shots': prov}, open(os.path.join(a.work, a.label + '-assembly.json'), 'w'), indent=1)
print('done', film, flush=True)
