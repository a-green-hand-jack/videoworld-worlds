import numpy as np, json
t=json.load(open('/hutian/editor/edit/timeline.json'))
W,H=128,72
c=np.fromfile('cut3_g.raw',np.uint8).reshape(-1,H,W).astype(np.float32)
o=np.fromfile('orig_g.raw',np.uint8).reshape(-1,H,W).astype(np.float32)
print(c.shape,o.shape)
def nz(x): x=x.reshape(len(x),-1) if x.ndim==3 else x.reshape(-1); return x
def norm(a):
    a=a.reshape(len(a),-1); a=a-a.mean(1,keepdims=True); return a/(np.linalg.norm(a,axis=1,keepdims=True)+1e-6)
on=norm(o[::6]) # every 0.25 s
res=[]
for s in t['shots']:
    a,b=s['frame_in'],s['frame_out']
    if b<=a or a>=len(c): continue
    b=min(b,len(c))
    seg=c[a:b]
    d=np.abs(np.diff(seg,axis=0)).mean(axis=(1,2)) if len(seg)>1 else np.array([0])
    mid=seg[len(seg)//2]
    # aligned original correlation (mid) 
    oi=min(len(o)-1,a+len(seg)//2)
    cm=norm(mid[None])[0]
    al=float((cm*norm(o[oi][None])[0]).sum())
    best=float((on@cm).max()); bi=int((on@cm).argmax())*6/24
    fl=float(np.abs(seg[-1]-seg[0]).mean())
    frozen=int((d<0.02).sum())
    res.append(dict(id=s['id'],a=a,n=b-a,motion=round(float(d.mean()),2),maxjump=round(float(d.max()),1),firstlast=round(fl,1),frozen=frozen,aligned_corr=round(al,2),best_orig_corr=round(best,2),best_t=bi))
json.dump(res,open('shotan.json','w'))
for r in res:
    flag=[]
    if r['best_orig_corr']>0.85: flag.append('ORIG?')
    if r['motion']<0.25 and r['n']>24: flag.append('lowmotion')
    if r['maxjump']>25 and r['n']>2: flag.append('jump')
    if r['frozen']>0.5*r['n'] and r['n']>24: flag.append('frozen')
    if flag: print(r['id'],r['a'],r['n'],r['motion'],r['maxjump'],r['frozen'],r['aligned_corr'],r['best_orig_corr'],flag)
print('max aligned',max(r['aligned_corr'] for r in res),'max best',max(r['best_orig_corr'] for r in res))
print(sorted(res,key=lambda r:-r['best_orig_corr'])[:6])
