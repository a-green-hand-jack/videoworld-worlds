import numpy as np, json
t=json.load(open('/hutian/editor/edit/timeline.json'))
W,H=256,144
c=np.fromfile('cut6_g256.raw',np.uint8).reshape(-1,H,W)
print(c.shape)
o=np.fromfile('orig_g.raw',np.uint8).reshape(-1,72,128).astype(np.float32)
c8=np.fromfile('cut6_g.raw',np.uint8).reshape(-1,72,128).astype(np.float32)
def norm(a):
    a=a.reshape(len(a),-1); a=a-a.mean(1,keepdims=True); return a/(np.linalg.norm(a,axis=1,keepdims=True)+1e-6)
on=norm(o[::6])
res=[]
prevmid=None
for s in t['shots']:
    a,b=s['frame_in'],s['frame_out']
    if b<=a or a>=len(c): continue
    b=min(b,len(c)); n=b-a
    seg=c[a:b].astype(np.float32)
    d=np.abs(np.diff(seg,axis=0)).mean(axis=(1,2)) if n>1 else np.zeros(1)
    ufps=float((d>0.3).sum())/(n/24) if n>24 else None
    mid=c8[a+n//2]; cm=norm(mid[None])[0]
    best=float((on@cm).max())
    fl=float(np.abs(seg[-1]-seg[0]).mean())
    mj=float(d.max())
    res.append(dict(id=s['id'],a=a,n=n,ufps=None if ufps is None else round(ufps,1),motion=round(float(d.mean()),2),maxjump=round(mj,1),firstlast=round(fl,1),best_orig=round(best,2),jumps=[int(i) for i in np.where(d>20)[0]]))
json.dump(res,open('an6.json','w'))
print('max best orig',max(r['best_orig'] for r in res))
print('ufps<20:',[(r['id'],r['n'],r['ufps']) for r in res if r['ufps'] is not None and r['ufps']<20])
print('count >24 frames',sum(1 for r in res if r['ufps'] is not None))
import statistics
print('median',statistics.median(r['ufps'] for r in res if r['ufps'] is not None))
print('lowmotion',[(r['id'],r['n'],r['motion'],r['firstlast']) for r in res if r['n']>24 and r['firstlast']<3])
print('internal jumps',[(r['id'],r['jumps']) for r in res if r['jumps'] and len(r['jumps'])>0 and r['n']>3 and any(0<j<r['n']-2 for j in r['jumps'])])
