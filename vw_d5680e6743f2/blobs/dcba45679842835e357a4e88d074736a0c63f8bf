#!/bin/bash
set -euo pipefail
stem="$1"
curl -sS --fail-with-body "$OPENAI_BASE_URL/images/edits" -H "Authorization: Bearer $OPENAI_API_KEY" -H 'Content-Type: application/json' --data-binary "@/hutian/request-${stem}.json" -o "/hutian/response-${stem}.json"
python3 production/decode_image_response.py "/hutian/response-${stem}.json" "picture/stills/${stem}.png"
