#!/usr/bin/env python3
"""Render continuous subpixel camera moves from approved stills, no text or sound."""
from pathlib import Path
import json, subprocess
from PIL import Image
ROOT=Path(__file__).resolve().parents[1]
# name, frames, zoom start/end, anchor start/end (fractions in source frame)
SPECS=[
 ('title_plate',84,1.00,1.02,(.5,.5),(.5,.5)),
 ('shot01',96,1.00,1.06,(.35,.68),(.35,.68)),
 ('shot02',96,1.12,1.12,(.05,.55),(.95,.55)),
 ('shot03',96,1.08,1.08,(.25,.55),(.75,.55)),
 ('shot04',84,1.055,1.00,(.40,.58),(.40,.58)),
 ('shot05',72,1.00,1.065,(.52,.51),(.52,.51)),
 ('end_plate',48,1.00,1.00,(.5,.5),(.5,.5))]
def render(spec):
 name,n,z0,z1,a0,a1=spec
 img=Image.open(ROOT/'picture/stills'/f'{name}.png').convert('RGB')
 w,h=img.size
 dest=ROOT/'picture/clips'/f'{name}.mp4'
 cmd=['ffmpeg','-v','error','-y','-f','rawvideo','-pixel_format','rgb24','-video_size','1280x720','-framerate','24','-i','pipe:0','-an','-c:v','libx264','-threads','2','-preset','medium','-crf','16','-pix_fmt','yuv420p','-movflags','+faststart',str(dest)]
 p=subprocess.Popen(cmd,stdin=subprocess.PIPE)
 checks=ROOT/'picture/checkframes';checks.mkdir(exist_ok=True)
 for f in range(n):
  t=f/(n-1);z=z0+(z1-z0)*t
  ax=a0[0]+(a1[0]-a0[0])*t;ay=a0[1]+(a1[1]-a0[1])*t
  cw=w/z;ch=cw*9/16
  if ch>h:ch=h/z;cw=ch*16/9
  x=(w-cw)*ax;y=(h-ch)*ay
  frame=img.transform((1280,720),Image.Transform.AFFINE,(cw/1280,0,x,0,ch/720,y),Image.Resampling.BICUBIC)
  p.stdin.write(frame.tobytes())
  if f in [0,n//2,n-1]:frame.save(checks/f'{name}-{f:03d}.jpg',quality=94)
 p.stdin.close()
 if p.wait():raise RuntimeError(name)
 print(f'Rendered {name}: {n} frames, {n/24:.3f}s',flush=True)
 return {'file':f'picture/clips/{name}.mp4','still':f'picture/stills/{name}.png','frames':n,'fps':24,'seconds':n/24,'zoom':[z0,z1],'anchor':[a0,a1]}
if __name__=='__main__':
 (ROOT/'picture/clips').mkdir(exist_ok=True)
 import sys
 selected=set(sys.argv[1:])
 existing=json.loads((ROOT/'picture/camera-moves.json').read_text()) if (ROOT/'picture/camera-moves.json').exists() else []
 by_file={r['file']:r for r in existing}
 for s in SPECS:
  if not selected or s[0] in selected:
   result=render(s);by_file[result['file']]=result
 log=[by_file[f'picture/clips/{s[0]}.mp4'] for s in SPECS if f'picture/clips/{s[0]}.mp4' in by_file]
 (ROOT/'picture/camera-moves.json').write_text(json.dumps(log,indent=2)+'\n')
