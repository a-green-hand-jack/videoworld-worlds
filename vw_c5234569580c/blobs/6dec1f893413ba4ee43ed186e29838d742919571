#!/usr/bin/env bash
# Measure the hard items H2-H7 of direction/delivery-spec.md and sample frames for watching.
# usage: tools/qc.sh FILE.mp4 OUTDIR
set -u
f="$1"; out="$2"; mkdir -p "$out/frames"
echo "== streams"; ffprobe -v error -show_entries stream=index,codec_type,codec_name,profile,width,height,sample_aspect_ratio,pix_fmt,r_frame_rate,avg_frame_rate,sample_rate,channels,channel_layout,duration,nb_frames -show_entries format=format_name,duration,size -of default=nw=1 "$f"
echo "== moov before mdat (faststart)"; python3 - "$f" <<'PY'
import sys,struct
d=open(sys.argv[1],'rb').read(); i=0; order=[]
while i+8<=len(d):
    n,t=struct.unpack('>I4s',d[i:i+8]); order.append(t.decode('latin1'))
    if n==1: n=struct.unpack('>Q',d[i+8:i+16])[0]
    if n==0: break
    i+=n
print(order, 'faststart OK' if 'moov' in order and 'mdat' in order and order.index('moov')<order.index('mdat') else 'NOT faststart')
PY
echo "== decode errors"; ffmpeg -v error -i "$f" -f null - 2>&1 | head -20; echo "(end decode)"
echo "== loudness / peak"; ffmpeg -hide_banner -nostats -i "$f" -af ebur128=peak=true -f null - 2>&1 | grep -A12 Summary
echo "== silence > 0.5 s at -50 dB"; ffmpeg -hide_banner -nostats -i "$f" -af silencedetect=n=-50dB:d=0.5 -f null - 2>&1 | grep silence_
echo "== scene changes"; ffmpeg -hide_banner -nostats -i "$f" -vf "select='gt(scene,0.25)',showinfo" -f null - 2>&1 | grep -o 'pts_time:[0-9.]*'
ffmpeg -v error -y -i "$f" -vf fps=2,scale=640:-1 "$out/frames/f_%03d.jpg"
ffmpeg -v error -y -i "$f" -vf "fps=2,scale=256:-1,tile=8x6" -frames:v 1 "$out/contact.jpg"
ffmpeg -v error -y -i "$f" -vn -ac 2 -ar 48000 "$out/audio.wav"
ffmpeg -v error -y -i "$f" -lavfi showspectrumpic=s=1024x400 "$out/spectrum.png"
echo "frames, contact sheet, audio.wav, spectrum.png in $out"
