"""Procedural placeholder stills (temp picture for rough cuts only, until production-designer's stills arrive).
Usage: placeholder_stills.py OUTDIR"""
import sys, os
import numpy as np
from PIL import Image, ImageDraw, ImageFilter
W, H = 1792, 1008
out = sys.argv[1]; os.makedirs(out, exist_ok=True)
rng = np.random.default_rng(3)

def sky(top, mid, bot, horizon=0.55):
    y = np.linspace(0, 1, H)[:, None, None]
    top, mid, bot = [np.array(c, float)[None, None, :] for c in (top, mid, bot)]
    k = np.clip(y / horizon, 0, 1)
    img = top * (1 - k) + mid * k
    return np.repeat(img, W, 1)

def finish(arr, name):
    Image.fromarray(np.clip(arr, 0, 255).astype('uint8')).save(os.path.join(out, name))

def glow(arr, x, y, r, col, a=1.0):
    yy, xx = np.mgrid[0:H, 0:W]
    d = np.sqrt((xx - x) ** 2 + (yy - y) ** 2)
    g = np.exp(-(d / r) ** 2) * a
    arr += g[:, :, None] * np.array(col)[None, None, :]
    return arr

def stars(arr, n, ymax):
    for _ in range(n):
        x, y = rng.integers(0, W), rng.integers(0, int(H * ymax))
        arr[y:y + 2, x:x + 2] += rng.uniform(80, 220)
    return arr

def village(img, y0, scale=1.0, lit=True):
    d = ImageDraw.Draw(img)
    x = -20
    while x < W:
        w = int(rng.integers(90, 170) * scale); h = int(rng.integers(50, 110) * scale)
        d.rectangle([x, y0 - h, x + w, y0], fill=(18, 16, 40))
        d.polygon([(x - 8, y0 - h), (x + w / 2, y0 - h - 45 * scale), (x + w + 8, y0 - h)], fill=(14, 12, 34))
        if lit:
            for wx in range(x + 18, x + w - 20, 38):
                d.rectangle([wx, y0 - h + 22, wx + 12, y0 - h + 38], fill=(255, 190, 90))
        x += w + int(rng.integers(6, 40))
    return img

def lantern(d, cx, cy, s, glowcol=(255, 170, 70)):
    d.rectangle([cx - s, cy - s, cx + s, cy + s], fill=(250, 232, 190), outline=(110, 70, 40), width=max(2, s // 12))
    d.line([cx, cy - s, cx, cy + s], fill=(120, 80, 45), width=max(2, s // 14))
    d.line([cx - s, cy, cx + s, cy], fill=(120, 80, 45), width=max(2, s // 14))

def child(d, x, y, s, hands_out=False):
    d.ellipse([x - s * .45, y - s * 2.3, x + s * .45, y - s * 1.4], fill=(235, 195, 160))
    d.pieslice([x - s * .5, y - s * 2.4, x + s * .5, y - s * 1.55], 180, 360, fill=(30, 22, 25))
    d.polygon([(x - s * .8, y - s * 1.35), (x + s * .8, y - s * 1.35), (x + s * 1.0, y), (x - s * 1.0, y)], fill=(130, 175, 220))
    d.rectangle([x - s * .6, y - s * 1.45, x + s * .6, y - s * 1.2], fill=(200, 40, 50))

def river_base(top, mid, bot):
    a = sky(top, mid, bot)
    return a

# ---- title plate / end plate: dusk sky over river, no lantern text
def plate(name, stars_n, lantern_xy=None):
    a = sky((30, 28, 80), (120, 80, 120), (50, 40, 90), 0.62)
    a[int(H * .62):] = a[int(H * .62):] * 0.5 + np.array([25, 25, 70])
    a = stars(a, stars_n, 0.4)
    img = Image.fromarray(np.clip(a, 0, 255).astype('uint8'))
    img = village(img, int(H * .62), 1.0)
    a = np.array(img).astype(float)
    if lantern_xy:
        a = glow(a, *lantern_xy, 70, (255, 160, 60), 0.9)
    finish(a, name)

