"""Synthesize the film's sound: river + evening ambience, a water touch, and a soft music cue.
Writes a 48 kHz stereo 16-bit WAV, 20 s. Usage: make_sound.py OUT.wav"""
import sys
import numpy as np
import soundfile as sf
from scipy.signal import butter, sosfilt, fftconvolve

SR = 48000
DUR = 20.0
N = int(SR * DUR)
t = np.arange(N) / SR
rng = np.random.default_rng(7)


def bp(x, lo, hi, order=2):
    return sosfilt(butter(order, [lo, hi], btype="band", fs=SR, output="sos"), x)


def lp(x, f, order=2):
    return sosfilt(butter(order, f, btype="low", fs=SR, output="sos"), x)


def smooth_noise(rate, seed):
    """slow random curve in [0,1] sampled at `rate` Hz and interpolated"""
    r = np.random.default_rng(seed)
    k = r.random(int(DUR * rate) + 3)
    return np.interp(t, np.arange(len(k)) / rate, k)


def env_ad(n, a, d):
    e = np.ones(n)
    na, nd = int(a * SR), int(d * SR)
    e[:na] = np.linspace(0, 1, na)
    e[-nd:] = np.linspace(1, 0, nd)
    return e


# ---- river: low rumble + mid burble, gently modulated, decorrelated L/R
def river(seed):
    r = np.random.default_rng(seed)
    n = r.standard_normal(N)
    low = bp(n, 200, 500) * 0.5
    mid = bp(n, 400, 1800) * (0.35 + 0.65 * smooth_noise(3, seed + 1))
    hiss = bp(n, 2500, 6000) * 0.015 * (0.4 + smooth_noise(2, seed + 2))
    return low + mid * 0.8 + hiss

# soft lapping: slow swell
lap = 0.75 + 0.25 * np.sin(2 * np.pi * 0.23 * t + 1.0)
BED, BUB = 0.05, 0.05
rl, rr = river(10) * lap, river(20) * lap
rl /= np.std(rl); rr /= np.std(rr)
water = np.stack([rl, rr], 1) * BED


def bubbles(seed, rate=30.0):
    """water texture: many short upward-gliding sine 'bloops' (400-2500 Hz), the sound of small bubbles and wavelets"""
    r = np.random.default_rng(seed)
    out = np.zeros((N, 2))
    ev = np.cumsum(r.exponential(1.0 / rate, int(rate * DUR * 1.3)))
    for t0 in ev[ev < DUR - 0.2]:
        d = r.uniform(0.02, 0.07)
        n = int(d * 4 * SR)
        tt = np.arange(n) / SR
        f0 = np.exp(r.uniform(np.log(400), np.log(2500)))
        f = f0 * (1 + r.uniform(1.5, 4) * tt / d * 0.5)
        sig = np.sin(2 * np.pi * np.cumsum(f) / SR) * np.exp(-tt / d) * np.minimum(1, tt / 0.003)
        # louder swell with the lapping
        amp = r.uniform(0.2, 1.0) * (0.6 + 0.4 * np.sin(2 * np.pi * 0.23 * t0 + 1.0))
        pan = r.uniform(0, 1)
        i = int(t0 * SR)
        out[i:i + n, 0] += sig * amp * (1 - pan)
        out[i:i + n, 1] += sig * amp * pan
    return out

water = water + bubbles(11) * BUB

# ---- evening air: faint wind
w = bp(rng.standard_normal(N), 200, 900) * (0.3 + smooth_noise(0.4, 5))
w2 = bp(rng.standard_normal(N), 200, 900) * (0.3 + smooth_noise(0.4, 6))
wind = np.stack([w / np.std(w), w2 / np.std(w2)], 1) * 0.02

# ---- crickets: each individual chirps in short groups of 3-5 resonant pulses (~12 ms each, ~40 Hz pulse
# rate), 1-3 chirps per second, with jitter in timing, pitch and level, plus a little breath of noise.
def cricket(f0, chirps_per_s, pan, level, seed):
    r = np.random.default_rng(seed)
    out = np.zeros(N)
    tt = np.arange(int(0.02 * SR)) / SR
    tc = r.uniform(0, 0.5)
    while tc < DUR - 0.2:
        npulse = int(r.integers(3, 6))
        f = f0 * (1 + r.normal(0, 0.012))
        gap = r.normal(1.0 / 40, 0.0015)
        for k in range(npulse):
            p0 = tc + k * gap
            i = int(p0 * SR)
            if i + len(tt) >= N: break
            amp = (0.65 + 0.35 * np.sin(np.pi * (k + 0.5) / npulse)) * r.uniform(0.85, 1.0)
            ff = f * (1 + 0.01 * k)
            pulse = np.sin(2 * np.pi * ff * tt) * np.exp(-tt / 0.0055) * np.minimum(1, tt / 0.0012)
            out[i:i + len(tt)] += pulse * amp
        tc += (1.0 / chirps_per_s) * r.uniform(0.75, 1.3) + 0.05
    return out[:, None] * np.array([np.cos(pan), np.sin(pan)])[None, :] * level

crick = np.zeros((N, 2))
for f, rate, pan, lvl, s_ in [(4350, 1.7, 0.3, 1.0, 1), (4750, 2.2, 1.2, 0.8, 2), (3950, 1.3, 0.8, 0.6, 3), (5200, 1.9, 0.6, 0.5, 4), (4100, 2.6, 1.4, 0.45, 5)]:
    crick += cricket(f, rate, pan, lvl, s_)
# crickets: audible early (shot 1), fading as the lantern leaves, almost gone by the stars
cr_env = np.interp(t, [0, 1.2, 3, 9.5, 13.5, 17, 20], [0, 0.8, 1.0, 0.8, 0.35, 0.1, 0.0])
crick *= 0.3 * cr_env[:, None]

# ---- water touch at the release (shot 2, ~7.0 s): soft plip + ripple
def plip(t0, level=1.0):
    n = int(0.9 * SR)
    tt = np.arange(n) / SR
    f = 520 * np.exp(-tt * 5) + 220
    tone = np.sin(2 * np.pi * np.cumsum(f) / SR) * np.exp(-tt * 9)
    ns = bp(rng.standard_normal(n), 500, 3500) * np.exp(-tt * 14) * 0.5
    drop = (tone + ns) * level
    drop *= np.minimum(1, tt / 0.004)
    out = np.zeros((N, 2))
    i = int(t0 * SR)
    out[i:i + n, 0] += drop * 0.9
    out[i:i + n, 1] += drop * 1.0
    return out

touch = plip(7.0, 0.05) + plip(7.35, 0.014) + plip(7.7, 0.007)

# ---- music: music-box melody over a warm pad; D major pentatonic.
def midi(m): return 440.0 * 2 ** ((m - 69) / 12)

def bell(f, dur=3.5, level=1.0):
    n = int(dur * SR)
    tt = np.arange(n) / SR
    s = (np.sin(2 * np.pi * f * tt) * np.exp(-tt * 1.6)
         + 0.35 * np.sin(2 * np.pi * f * 2.0 * tt) * np.exp(-tt * 3.2)
         + 0.12 * np.sin(2 * np.pi * f * 3.01 * tt) * np.exp(-tt * 6)
         + 0.05 * np.sin(2 * np.pi * f * 5.4 * tt) * np.exp(-tt * 12))
    s *= np.minimum(1, tt / 0.006)
    return s * level

def place(sig, track, t0, pan=0.5):
    i = int(t0 * SR)
    n = min(len(sig), N - i)
    track[i:i + n, 0] += sig[:n] * (1 - pan)
    track[i:i + n, 1] += sig[:n] * pan

music = np.zeros((N, 2))
# melody (time s, midi note, velocity): music-box phrase that rises with the lantern, then settles
D5, E5, FS5, A5, B5, D6 = 74, 76, 78, 81, 83, 86
mel = [
    (0.6, D5, .5), (1.4, FS5, .45), (2.2, A5, .5),
    (3.6, B5, .45), (4.6, A5, .4),
    (6.2, FS5, .45), (7.4, E5, .4),
    (9.0, D5, .45), (10.0, FS5, .45), (11.0, A5, .5), (12.2, B5, .5),
    (13.4, D6, .55), (14.6, B5, .5), (15.6, A5, .5), (16.6, FS5, .45),
    (17.8, D5, .45), (18.8, D5 - 12, .35),
]
for k, (ts, m, v) in enumerate(mel):
    place(bell(midi(m), 3.5, v * 0.16), music, ts, pan=0.35 + 0.3 * ((k * 0.37) % 1))

# pad: slow chords D - Bm - G - A - D, sine stacks with slow attack/release
def pad_chord(notes, t0, t1, level):
    seg = np.zeros(N)
    for m in notes:
        f = midi(m)
        for det in (-0.003, 0.0, 0.003):
            seg += np.sin(2 * np.pi * f * (1 + det) * t) + 0.3 * np.sin(4 * np.pi * f * (1 + det) * t)
    a = 1.8
    e = np.clip((t - t0) / a, 0, 1) * np.clip((t1 - t) / a, 0, 1)
    return seg * e * level

chords = [([50, 57, 62, 66], 0.0, 5.5), ([47, 54, 62, 66], 4.0, 9.5), ([43, 55, 62, 67], 8.0, 13.5),
          ([45, 57, 61, 64], 12.0, 17.0), ([50, 57, 62, 66, 74], 15.5, 20.5)]
pad = np.zeros(N)
for ns, a, b in chords:
    pad += pad_chord(ns, a, b, 0.008)
# swell over shot 4 (13-17.5 s), settle in the end card
swell = np.interp(t, [0, 3, 9, 13, 15.5, 17.5, 20], [0.35, 0.55, 0.6, 0.8, 1.0, 0.75, 0.45])
pad = lp(pad, 1800) * swell
pad_st = np.stack([pad, np.roll(pad, 41)], 1)
music += pad_st

# lift the music over shot 4 (13.5-17 s) so the stars are heard, then let it settle
music *= np.interp(t, [0, 12.5, 14.5, 16.5, 18.5, 20], [1, 1, 1.5, 1.5, 1.0, 0.9])[:, None]

# a little room: short diffuse reverb on the music
ir_n = int(1.6 * SR)
ir = rng.standard_normal(ir_n) * np.exp(-np.arange(ir_n) / SR * 3.2)
ir = lp(ir, 5000)
ir /= np.sqrt(np.sum(ir ** 2))
wet = np.stack([fftconvolve(music[:, 0], ir)[:N], fftconvolve(music[:, 1], np.roll(ir, 97))[:N]], 1)
music = music * 0.65 + wet * 0.55

# crickets vs river in the cricket band (4-5 kHz), seconds 1-6, for the log
_b = lambda x: bp(x[int(1 * SR):int(6 * SR)], 4000, 5000)
print("cricket band over river band, 1-6 s: %.1f dB" % (20 * np.log10(np.std(_b(crick[:, 0])) / np.std(_b(water[:, 0])))))

# ---- mix
fade = env_ad(N, 1.5, 2.0)
mix = (water + wind + crick + touch + music) * fade[:, None]
mix = np.tanh(mix * 1.1) / 1.1  # gentle safety rounding
# normalise so the 20 s integrated level lands near -16 LUFS (checked with ffmpeg ebur128 in the build script)
gain = float(sys.argv[2]) if len(sys.argv) > 2 else 1.0
mix *= gain
print("peak", np.abs(mix).max(), "rms dBFS", 20 * np.log10(np.sqrt((mix ** 2).mean())))
sf.write(sys.argv[1], mix, SR, subtype="PCM_16")
if len(sys.argv) > 3:  # stems for listening/classifying: STEMDIR
    import os
    os.makedirs(sys.argv[3], exist_ok=True)
    for nm, st in [("water_wind", water + wind), ("crickets", crick), ("music", music)]:
        sf.write(os.path.join(sys.argv[3], nm + ".wav"), st * fade[:, None] * gain, SR, subtype="PCM_16")
