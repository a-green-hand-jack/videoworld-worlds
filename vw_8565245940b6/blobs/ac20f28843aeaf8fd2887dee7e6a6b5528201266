from pathlib import Path
import subprocess,json
import numpy as np
from PIL import Image,ImageDraw,ImageFont
root=Path(__file__).resolve().parents[1]
evidence=root/'picture/evidence'
report={}
sheet=Image.new('RGB',(1440,1200),(12,18,30));d=ImageDraw.Draw(sheet);font=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf',15)
for i,n in enumerate([108,108,120,108],1):
 path=root/f'picture/shots/S{i}.mp4'
 probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(path)]))
 streams=probe['streams'];s=streams[0]
 assert len(streams)==1 and s['codec_type']=='video' and s['width']==1280 and s['height']==720 and s['r_frame_rate']=='24/1' and s['pix_fmt']=='yuv420p'
 p=subprocess.Popen(['ffmpeg','-v','error','-i',str(path),'-f','rawvideo','-pix_fmt','rgb24','-'],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
 previous=None;deltas=[];means=[];count=0;frozen=0;longest=0
 for f in range(n):
  b=p.stdout.read(1280*720*3)
  assert len(b)==1280*720*3
  a=np.frombuffer(b,dtype=np.uint8).reshape(720,1280,3)
  means.append(float(a.mean()))
  if previous is not None:
   delta=float(np.abs(a.astype(np.int16)-previous.astype(np.int16)).mean());deltas.append(delta)
   frozen=frozen+1 if delta==0 else 0;longest=max(longest,frozen)
  previous=a.copy();count+=1
  if f in (0,n//2,n-1):
   im=Image.fromarray(a);im.save(evidence/f'S{i}-decoded-{f:03d}.jpg',quality=95)
   col=[0,n//2,n-1].index(f);sheet.paste(im.resize((480,270),Image.Resampling.LANCZOS),(col*480,(i-1)*300));d.text((col*480+10,(i-1)*300+274),f'S{i}  frame {f:03d}  {f/24:.3f}s',font=font,fill=(240,226,200))
 assert p.stdout.read(1)==b'';p.stdout.close();err=p.stderr.read().decode();assert p.wait()==0 and not err,err
 assert count==n and min(means)>1 and longest<12
 report[f'S{i}']={'decoded_frames':count,'duration':float(probe['format']['duration']),'width':s['width'],'height':s['height'],'frame_rate':s['r_frame_rate'],'codec':s['codec_name'],'pixel_format':s['pix_fmt'],'audio_streams':0,'mean_rgb_min':min(means),'mean_rgb_max':max(means),'adjacent_frame_mean_absolute_rgb_change_min':min(deltas),'adjacent_frame_mean_absolute_rgb_change_max':max(deltas),'longest_identical_frame_transition_run':longest,'decode_errors':err}
sheet.save(evidence/'encoded-shot-contact-sheet.jpg',quality=95)
(evidence/'technical-checks.json').write_text(json.dumps(report,indent=2)+'\n')
print(json.dumps(report,indent=2))
