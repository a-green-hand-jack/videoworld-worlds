import numpy as np, soundfile as sf
from scipy.signal import butter, sosfilt
sr=48000; D=20.0; n=int(sr*D); t=np.arange(n)/sr
rng=np.random.default_rng(7)
def bp(x,lo,hi,o=2): return sosfilt(butter(o,[lo,hi],'band',fs=sr,output='sos'),x)
def lp(x,f,o=2): return sosfilt(butter(o,f,'low',fs=sr,output='sos'),x)
def stereo_noise(): return rng.standard_normal(n), rng.standard_normal(n)
# water: filtered noise with slow amplitude modulation
L=[];
for ch in range(2):
    w=rng.standard_normal(n)
    a=bp(w,200,1800)*(0.6+0.4*np.sin(2*np.pi*(0.23+0.05*ch)*t+ch))
    b=bp(rng.standard_normal(n),1800,5000)*0.15*(0.5+0.5*np.sin(2*np.pi*0.41*t+2*ch))
    L.append(a+b)
water=np.stack(L,1); water/=np.abs(water).max(); water*=0.30
# wind
wind=np.stack([lp(rng.standard_normal(n),400)*(0.5+0.5*np.sin(2*np.pi*0.07*t+k)) for k in (0,1.5)],1)
wind/=np.abs(wind).max(); wind*=0.12
# crickets: pulsed high sine, fading in after 1s
cr=np.zeros((n,2))
for ch,f in enumerate((4300,4650)):
    gate=(np.sin(2*np.pi*(5.5+ch*0.4)*t)>0.2)*(0.5+0.5*np.sin(2*np.pi*0.15*t+ch*2))
    cr[:,ch]=np.sin(2*np.pi*f*t)*lp(gate.astype(float),30)*0.012
amb=water+wind+cr
# music: pentatonic bells + pad
def bell(f,t0,dur=3.5,amp=0.15,pan=0.5):
    m=np.zeros(n); i0=int(t0*sr); k=int(dur*sr); k=min(k,n-i0); tt=np.arange(k)/sr
    s=(np.sin(2*np.pi*f*tt)+0.35*np.sin(2*np.pi*2.01*f*tt)*np.exp(-tt*3)+0.15*np.sin(2*np.pi*3.99*f*tt)*np.exp(-tt*6))
    e=np.minimum(tt/0.01,1)*np.exp(-tt*1.4); m[i0:i0+k]=s*e*amp
    return np.stack([m*(1-pan),m*pan],1)*2
N=dict(D4=293.66,E4=329.63,G4=392.0,A4=440.0,B4=493.88,D5=587.33,E5=659.25,G5=783.99,A5=880.0,D3=146.83,A3=220.0)
notes=[(5.0,'D4'),(5.9,'A4'),(6.8,'B4'),(7.9,'D5'),(8.5,'E5'),(9.6,'G5'),(10.8,'D5'),(12.0,'A4'),(13.2,'B4'),
       (14.4,'D5'),(15.6,'E5'),(16.6,'G5'),(17.6,'A5'),(18.2,'D5')]
mus=np.zeros((n,2))
for i,(t0,nm) in enumerate(notes):
    mus+=bell(N[nm],t0,dur=4 if t0>15 else 3.2,amp=0.16 if t0<15 else 0.13,pan=0.3+0.4*((i*0.37)%1))
# pad: D major-ish sus, swells 5s-19s
pad=np.zeros(n)
for f in (146.83,220.0,293.66,440.0):
    pad+=np.sin(2*np.pi*f*t+rng.uniform(0,6))+0.5*np.sin(2*np.pi*f*1.003*t)
env=np.interp(t,[0,5,9,15,19,20],[0,0,0.05,0.07,0.04,0])
pad=pad*env*0.35
mus+=pad[:,None]*np.array([1,1])
mix=amb+mus*0.9
fade=np.interp(t,[0,1,18,20],[0,1,1,0]) 
mix*=fade[:,None]
# reverb-ish: simple echo
for d,g in ((0.23,0.25),(0.41,0.15)):
    k=int(d*sr); e=np.zeros_like(mix); e[k:]=mix[:-k]*g; mix=mix+e
pk=np.abs(mix).max(); mix*=0.8/pk
sf.write('sound/paper-lantern-mix.wav',mix,sr,subtype='PCM_16')
print('peak',np.abs(mix).max())
