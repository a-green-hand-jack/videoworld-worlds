"""Synthesize the Paper Lantern soundtrack: water + evening ambience, soft music cue. 20.0s stereo 48k."""
import numpy as np, soundfile as sf
from scipy.signal import butter, sosfilt
sr=48000; T=20.0; n=int(sr*T); t=np.arange(n)/sr
rng=np.random.default_rng(7)
def bp(x,lo,hi,o=2): return sosfilt(butter(o,[lo,hi],btype='band',fs=sr,output='sos'),x)
def lp(x,f,o=2): return sosfilt(butter(o,f,btype='low',fs=sr,output='sos'),x)
# water: filtered noise with slow amplitude swell, decorrelated L/R
def water(seed):
    r=np.random.default_rng(seed)
    w=bp(r.standard_normal(n),200,1800)*0.5+bp(r.standard_normal(n),1800,5000)*0.12
    lfo=0.6+0.4*np.sin(2*np.pi*0.17*t+r.uniform(0,6))*np.sin(2*np.pi*0.05*t+r.uniform(0,6))
    return w*lfo
# evening: crickets (gated high sine pulses) + low air
def crickets(seed,f0):
    r=np.random.default_rng(seed); out=np.zeros(n)
    gate=(np.sin(2*np.pi*(5.5+0.3*r.random())*t)>0.3)*(np.sin(2*np.pi*0.4*t+r.uniform(0,6))>-0.2)
    gate=lp(gate.astype(float),60,1)
    return np.sin(2*np.pi*f0*t)*gate*0.05
def bird(at,f=2600):
    tt=np.arange(int(sr*0.35))/sr
    return np.sin(2*np.pi*(f+900*np.sin(np.pi*tt/0.35)**2)*tt)*np.sin(np.pi*tt/0.35)**2*0.03
B=np.zeros(n)
for at,f in [(3.1,2600),(3.5,2900),(5.3,2500),(7.9,2700)]:  # faint evening bird, early only
    i=int(at*sr); x=bird(at,f); B[i:i+len(x)]+=x
cr=np.interp(t,[0,2,8,20],[0.4,1,1,0.8])
L=water(1)+crickets(2,4300)*cr+B; R=water(3)+crickets(4,4550)*cr+B*0.7
amb_env=np.interp(t,[0,2.0,18,20],[0,1,1,0])
# slightly quieter water over time as lantern drifts away
drift=np.interp(t,[0,2.5,6,12.5,15.5,20],[0.8,0.9,1,1,0.6,0.5])  # close lapping in shots 2-3, wider/softer in 4-5
L*=amb_env*drift; R*=amb_env*drift
# music: soft pentatonic bell/pad cue, enters at 2.0 (first shot), lantern release at ~6.0 gets a rising motif
def bell(f,dur=3.0):
    tt=np.arange(int(sr*dur))/sr
    s=np.sin(2*np.pi*f*tt)+0.35*np.sin(2*np.pi*2*f*tt)*np.exp(-tt*3)+0.15*np.sin(2*np.pi*3.01*f*tt)*np.exp(-tt*6)
    return s*np.minimum(tt/0.01,1)*np.exp(-tt*1.6)
def pad(f,dur,att=1.5,rel=2.0):
    tt=np.arange(int(sr*dur))/sr
    s=sum(np.sin(2*np.pi*f*(1+d)*tt) for d in(-0.004,0,0.004))/3
    env=np.minimum(tt/att,1)*np.minimum((dur-tt)/rel,1)
    return s*env
M=np.zeros(n)
def put(x,at,g):
    i=int(at*sr); m=min(len(x),n-i); M[i:i+m]+=x[:m]*g
# Timeline (shotlist.md): T 0-2.5, s1 2.5-6, s2 6-9.5, s3 9.5-12.5 (release ~10.0), s4 12.5-15.5, s5 15.5-18, end 18-20
for f,at,d in [(146.83,2.5,7),(220.0,3.0,7),(110.0,9.0,7),(164.81,9.5,7),(246.94,12.5,7),(293.66,14.0,6.5)]:
    put(pad(f,d,2.0,2.5),at,0.05)
# melody D major pentatonic: D E F# A B
mel=[(2.5,587.33),(3.7,740.0),(4.9,880.0),(6.3,987.77),(7.8,880.0),(9.2,740.0),(10.8,659.26),(12.5,587.33),
     (13.6,880.0),(14.7,1174.66),(15.8,1479.98),(17.2,1174.66),(18.2,880.0)]
for at,f in mel: put(bell(f,3.5),at,0.085)
put(pad(293.66,3.4,0.8,1.8),16.6,0.06); put(pad(440.0,3.4,0.8,1.8),16.6,0.04)  # held resolving D/A into end card
# soft water touch when the lantern is set down (~10.0s): low filtered thump + ripple trickle
tt=np.arange(int(sr*1.6))/sr
touch=lp(np.random.default_rng(11).standard_normal(len(tt)),700,2)*np.exp(-tt*4)*np.minimum(tt/0.02,1)
touch+=0.6*np.sin(2*np.pi*(180-60*tt)*tt)*np.exp(-tt*6)
T2=np.zeros(n); i=int(10.0*sr); T2[i:i+len(tt)]=touch[:n-i]
M=lp(M,5000,1)
# gentle stereo spread for music
Lm=M+0.15*np.roll(M,int(0.012*sr)); Rm=M+0.15*np.roll(M,int(0.019*sr))
mus_env=np.interp(t,[0,2.0,18,20],[0,1,1,0]); Lm*=mus_env; Rm*=mus_env
out=np.stack([L*0.55+Lm+T2*0.25,R*0.55+Rm+T2*0.25],1)
pk=np.abs(out).max(); out=out/pk*0.57
out*=np.interp(t,[0,0.5,19,20],[0,1,1,0])[:,None]
sf.write('sound/paper-lantern-mix.wav',out,sr,subtype='PCM_16')
print('peak',np.abs(out).max(), 'rms',np.sqrt((out**2).mean()))
